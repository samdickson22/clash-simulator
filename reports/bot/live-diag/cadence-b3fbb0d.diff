diff --git a/bot/search/lopp_fast.py b/bot/search/lopp_fast.py
index bd56936e8..dd8e20b5b 100644
--- a/bot/search/lopp_fast.py
+++ b/bot/search/lopp_fast.py
@@ -736,11 +736,39 @@ def make_live_lopp(rt, name):
     search tier is this module's wall K4L. Suffix '-dR3a' keeps R3a as the cutoff default."""
     from bot.live.player import LivePlayer, live_belief_class  # noqa: F401  (LivePlayer.start installs it)
     from bot.search.lopp import make_lopp_player
+    import re
+    m = re.search(r'-si(\d+)(r?)$', name)          # decision cadence (live-diag): search every k ticks
+    si, si_roll = (int(m[1]), bool(m[2])) if m else (None, False)
+    full, name = name, (name[:m.start()] if m else name)
     body, dflt = (name[5:-5], 'R3a') if name.endswith('-dR3a') else (name[5:], 'it5s2')
     search = make_lopp_player(rt, body)
     if search.deadline_seconds is None:
         raise ValueError(f'{name}: the live tier needs w<ms>')
     live = LivePlayer(rt, tier='search', wall_ms=int(1000 * search.deadline_seconds), threads=search.threads,
-                      cutoff_default=dflt, name=name)
+                      cutoff_default=dflt, name=full)
     live.search = search
+    if si is not None:
+        set_cadence(live, si, si_roll)
     return live
+
+
+def set_cadence(live, k, rollout=False):
+    """Per-player decision cadence (name suffix -si<k>[r]; live-diag): the search decides on ticks divisible by k
+    (default SEARCH_INTERVAL = 10); the harness polls this seat every `poll_ticks` (5 when 5 divides k... k a multiple
+    of 5 -> 5; k dividing 5 -> k; else every tick), so the R3a poller keeps its 5-tick cadence. rollout=True: the
+    search's own rollout decision interval (C56SearchConfig.interval, default 10) follows k as well."""
+    from bot.players.base import POLICY_INTERVAL
+    k = int(k)
+    if k < 1:
+        raise ValueError(k)
+    live.search_ticks = live.search.search_ticks = k
+    live.poll_ticks = (POLICY_INTERVAL if k % POLICY_INTERVAL == 0 else (k if POLICY_INTERVAL % k == 0 else 1))
+    if rollout:
+        import dataclasses
+        start = live.search.start
+
+        def start_with_interval(ctx):
+            start(ctx)
+            core = live.search.p.core
+            core.config = dataclasses.replace(core.config, interval=k)
+        live.search.start = start_with_interval
