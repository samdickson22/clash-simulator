+def _skeleton_army(t0, n=15, life=300):
+    pts = [(9.0 + 1.6*np.cos(a), 22.0 + 1.6*np.sin(a)) for a in np.linspace(0, 2*np.pi, n, endpoint=False)]
+    return lambda t: [_u('Skeletons', x, y - .02*(t - t0)) for x, y in pts] if t0 <= t < t0 + life else []
