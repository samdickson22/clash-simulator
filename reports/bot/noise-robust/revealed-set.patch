+    plays.update({1800: 'Fireball', 2000: 'Earthquake'})
+    for t in range(100, 3605, 5):
+        units = [_u(c, 9, 20) for p, c in plays.items() if tr.cards.main.get(c) and p <= t < p + 100]
+        if 2500 <= t < 2560:
+            units.append(_u('Giant', 4.5, 20 - .02*(t - 2500)))
