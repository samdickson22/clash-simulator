+def _session(rt, player, stream):
+    from bot.live.resync import ResyncTranslator
+    from bot.live.translate import LiveSession
+    s = LiveSession(rt, player, OWN, seed=7, translator=ResyncTranslator(rt, OWN, plays_from='events'))
+    for r in stream:
+        s.step(r)
+    return s
