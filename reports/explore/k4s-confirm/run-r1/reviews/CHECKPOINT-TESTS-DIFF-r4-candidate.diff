+ elif case=='no_entry':write_history(tmp_path,phase='replacement-r1')
+ elif case=='two_entries':write_history(tmp_path,extra=[dict(phase='replacement-r2',dispatch_file='replacement-r2.json',dispatch_sha256=DSHA)])
