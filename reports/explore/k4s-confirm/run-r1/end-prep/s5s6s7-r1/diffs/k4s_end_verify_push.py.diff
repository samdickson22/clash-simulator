+def registry_claims(root, registry_exists):
+    """Health-only listing of the pushed claim directory (RC-5): every claim and this attempt's claims."""
+    registry = root / 'registry'
+    require(registry_exists == registry.is_dir() and not registry.is_symlink(), 'Registry/exit observation mismatch')
+    if not registry_exists:
+        return [], []
+    entries = sorted(registry.iterdir())
+    names = [p.name for p in entries]
+    require(names == ['attempt-%02d.json' % i for i in range(len(names))], 'Registry is not a contiguous claim sequence')
+    claims = []
+    for index, path in enumerate(entries):
+        require(path.is_file() and not path.is_symlink(), 'Verification check failed')
+        claim = json.loads(path.read_text())
+        require(claim['host'] == root.parent.name and claim['attempt'] == index, 'Registry claim namespace mismatch')
+        claims.append(dict(name=path.name, sha256=sha(path), attempt=claim['attempt'], round=claim['round'],
+                           receipt_directory=claim['receipt_directory'], launched_utc=claim['launched_utc']))
+    return claims, [c for c in claims if c['receipt_directory'] == root.name]
+
