+             "-c", "core.splitIndex=false", "-c", "core.untrackedCache=false", "-c", "gc.auto=0",
+             "-c", "gc.autoDetach=false", "-c", "maintenance.auto=false", "-c", "fetch.writeCommitGraph=false",
