+    returning bytes: hash pass (must equal the pinned blob OID), then copy pass (the copied bytes must hash to the pin
+    too; a mismatch refuses and the partial stays)."""
+    hash_e5(policy, role_name, rel)
+    item = _open_gated(policy, role_name, rel, None, None, False, e5=True)
+    try:
+        out = writer.open_excl(rel, e5=True)
+    except BaseException:
+        item.close()
+        raise
+    blob = _blob_digest(item.size)
+
+    def sink(chunk):
+        blob.update(chunk)
+        out.write(chunk)
+
+    try:
+        item._consume(sink)
+    except BaseException:
+        out.abort()
+        raise
+    result = out.finish(0o444)
+    require(blob.hexdigest() == e5_blob_oid(rel), "exemption", "E5 copy of %s does not hash to its pinned blob OID"
+            % rel)
+    return {"path": rel, "git_oid": blob.hexdigest(), "sha256": result["sha256"], "size": result["size"]}
+
+
+def hash_sealed_end_member(policy, role_name, rel, seal_sha256):
+    """D3 (S6 only): hash exactly one end-raw.json / end-complete.json inside a SEALED attempt directory and compare it
+    with the SHA-256 the caller took from that attempt's seal manifest. Returns {path, sha256, size}; the bytes never
+    reach the caller and are never parsed. The role must carry the D3 exemption (see _check_d3_role) and declare rel
+    exactly; the attempt's durable-measurement/ must hold both seal files (regular, st_nlink 1) before the member is
+    opened. Any other role, name or location refuses by name before any syscall."""
+    require(isinstance(seal_sha256, str) and SHA256_HEX.fullmatch(seal_sha256) is not None, "policy",
+            "D3 needs the seal manifest's SHA-256 for %s" % (rel,))
+    role, parts = _gate(policy, role_name, rel, "read", d3=True)
+    label = "%s:%s" % (role.name, rel)
+    root = open_root(role.root)
+    try:
+        sealed = open_dirs(root, parts[:2], label)
+    finally:
+        os.close(root)
+    try:
+        for name in D3_SEAL_FILES:
+            fd, _ = open_leaf(sealed, name, 64 << 20, None, "%s seal %s" % (label, name))
+            os.close(fd)
+        parent = open_dirs(sealed, parts[2:-1], label)
+    finally:
+        os.close(sealed)
+    try:
+        fd, st = open_leaf(parent, parts[-1], role.max_size, None, label)
+    finally:
+        os.close(parent)
+    item = Input(fd, st, label)
+    size = item.size
+    digest = item.sha256()
+    require(digest == seal_sha256, "sha", "D3 %s does not match its seal manifest SHA-256" % rel)
+    return {"path": rel, "sha256": digest, "size": size}
+
+
+def check_e1(policy, role_name):
+    """E1: the root-level symlink visualize_battle.py must have link text exactly examples/visualize_battle.py
+    (readlinkat; never followed). The target is gated as a normal input (opened and closed unread). Returns
+    {alias, link, target, target_size}. Read the target with open_input(policy, role, E1_LINK_TEXT)."""
+    role, _ = _gate(policy, role_name, E1_ALIAS, policy.role(role_name).access)
+    require("E1" in role.exemptions, "exemption", "role %s has no E1 exemption" % role.name)
+    root = open_root(role.root)
+    try:
+        try:
+            st = os.stat(E1_ALIAS, dir_fd=root, follow_symlinks=False)
+        except OSError as error:
+            refuse(_classify(error), "E1 %s: %s" % (E1_ALIAS, os.strerror(error.errno)))
+        require(stat.S_ISLNK(st.st_mode), "exemption", "E1 %s is not a symlink" % E1_ALIAS)
+        text = os.readlink(E1_ALIAS, dir_fd=root)
+    finally:
+        os.close(root)
+    require(text == E1_LINK_TEXT, "exemption", "E1 link text %r is not %r" % (text, E1_LINK_TEXT))
+    if role.access == "read":
+        target = open_input(policy, role_name, E1_LINK_TEXT)
+        size = target.size
+        target.close()
+    else:
+        size = None
+    return {"alias": E1_ALIAS, "link": text, "target": E1_LINK_TEXT, "target_size": size}
+
+
+# ---------------------------------------------------------------------------------------------------------------------
+# Directory checks and the confined recursive walk
+# ---------------------------------------------------------------------------------------------------------------------
+def check_dir(policy, role_name, rel=None):
+    """The role root (rel None) or a name-gated subdirectory must be a canonical directory; returns its identity."""
+    role = policy.role(role_name)
+    parts = []
+    if rel is not None:
+        parts = check_rel(rel)
+        name_gate(role.root + "/" + rel, policy.host, role.grants)
+    fd = open_root(role.root)
+    try:
+        sub = open_dirs(fd, parts, "%s:%s" % (role.name, rel))
+    finally:
+        os.close(fd)
+    st = os.fstat(sub)
+    os.close(sub)
+    return {"dev": st.st_dev, "ino": st.st_ino, "mode": st.st_mode}
+
+
+def check_absent(policy, role_name, rel):
+    """The parent must be a canonical directory and the leaf must not exist (not even as a dangling symlink)."""
+    role, parts = _gate(policy, role_name, rel, policy.role(role_name).access)
+    root = open_root(role.root)
+    try:
+        parent = open_dirs(root, parts[:-1], "%s:%s" % (role.name, rel))
+    finally:
+        os.close(root)
+    try:
+        os.stat(parts[-1], dir_fd=parent, follow_symlinks=False)
+    except FileNotFoundError:
+        return True
+    finally:
+        os.close(parent)
+    refuse("exists", "%s:%s exists" % (role.name, rel))
+
+
+def walk_tree(policy, role_name, rel_dir=None, max_entries=200000):
+    """Confined recursive inventory. Every entry name is gated BEFORE it is lstat'ed or entered; any forbidden name,
+    symlink (except the exact E1 alias at the root), special file, hard link, oversize or undeclared file refuses
+    the whole walk (no pruning). Returns {files: [{rel,size,dev,ino}], e1: None|{rel,link}, e4: [rel], e5: [rel]}.
+    Nothing is read; read files with open_input, E4 paths with hash_e4/copy_e4 and E5 paths (regular files only, E5
+    role) with hash_e5/copy_e5."""
+    role = policy.role(role_name)
+    require(role.access == "read", "policy", "walk_tree needs a read role")
+    base = []
+    if rel_dir is not None:
+        base = check_rel(rel_dir)
+        name_gate(role.root + "/" + rel_dir, policy.host, role.grants)
+    files, e4, e5, e1, count = [], [], [], None, [0]
+    root = open_root(role.root)
+    try:
+        start = open_dirs(root, base, "%s:%s" % (role.name, rel_dir))
+    finally:
+        os.close(root)
+    stack = [(start, base)]
+    try:
+        while stack:
+            fd, prefix = stack.pop()
+            try:
+                for name in sorted(os.listdir(fd)):
+                    count[0] += 1
+                    require(count[0] <= max_entries, "size", "walk exceeds %d entries" % max_entries)
+                    rel = "/".join(prefix + [name])
+                    check_rel(rel)
+                    is_e4 = "E4" in role.exemptions and rel in E4_COMPLETE_JSON
+                    is_e5 = "E5" in role.exemptions and e5_blob_oid(rel) is not None
+                    name_gate(role.root + "/" + rel, policy.host, role.grants, e4_leaf=is_e4,
+                              e5_rel=rel if is_e5 else None)
+                    st = os.stat(name, dir_fd=fd, follow_symlinks=False)
+                    if stat.S_ISLNK(st.st_mode):
+                        require("E1" in role.exemptions and rel == E1_ALIAS, "symlink", "symlink in tree: %s" % rel)
+                        link = os.readlink(name, dir_fd=fd)
+                        require(link == E1_LINK_TEXT, "exemption", "E1 link text %r is not %r" % (link, E1_LINK_TEXT))
+                        e1 = {"rel": rel, "link": link}
+                    elif stat.S_ISDIR(st.st_mode):
+                        require(not is_e5, "not-regular", "E5 path %s is a directory" % rel)
+                        stack.append((open_dirs(fd, [name], "%s:%s" % (role.name, rel)), prefix + [name]))
+                    elif stat.S_ISREG(st.st_mode):
+                        require(st.st_nlink == 1, "nlink", "hard-linked file in tree: %s" % rel)
+                        require(st.st_size <= role.max_size, "size", "oversize file in tree: %s" % rel)
+                        require(role.allows(rel), "allowlist", "role %s does not declare %s" % (role.name, rel))
+                        if is_e4:
+                            e4.append(rel)
+                        elif is_e5:
+                            e5.append(rel)
+                        else:
+                            files.append({"rel": rel, "size": st.st_size, "dev": st.st_dev, "ino": st.st_ino})
+                    else:
+                        refuse("not-regular", "special file in tree: %s" % rel)
+            finally:
+                os.close(fd)
+    finally:
+        for fd, _ in stack:
+            os.close(fd)
+    if e1 is not None:
+        require(any(f["rel"] == E1_LINK_TEXT for f in files), "exemption", "E1 target missing from the tree")
+    files.sort(key=lambda f: f["rel"])
+    return {"files": files, "e1": e1, "e4": sorted(e4), "e5": sorted(e5)}
+
+
+# ---------------------------------------------------------------------------------------------------------------------
+# Writes (item 7)
+# ---------------------------------------------------------------------------------------------------------------------
+class NewFile(object):
+    """An exclusively created file. write() is size-capped and hashed; finish() fsyncs file and directory."""
+
+    def __init__(self, fd, parent_fd, cap, label):
+        self._fd, self._parent, self._cap, self.label = fd, parent_fd, cap, label
+        self._size, self._digest = 0, hashlib.sha256()
+
+    def write(self, data):
+        require(self._fd is not None, "state", "%s already closed" % self.label)
+        require(self._size + len(data) <= self._cap, "size", "%s: write exceeds cap %d" % (self.label, self._cap))
+        view = memoryview(data)
+        while view:
+            view = view[os.write(self._fd, view):]
+        self._size += len(data)
+        self._digest.update(data)
+
+    def finish(self, mode=0o444):
+        require(self._fd is not None, "state", "%s already closed" % self.label)
+        os.fsync(self._fd)
+        os.fchmod(self._fd, mode)
+        os.close(self._fd)
+        self._fd = None
+        os.fsync(self._parent)
+        os.close(self._parent)
+        self._parent = None
+        return {"sha256": self._digest.hexdigest(), "size": self._size}
+
+    def abort(self):
+        """Close without publishing anything else; the partial file stays (never unlinked)."""
+        for attr in ("_fd", "_parent"):
+            fd = getattr(self, attr)
+            if fd is not None:
+                setattr(self, attr, None)
+                os.close(fd)
+
+
+class Writer(object):
+    """Write-only access below a canonical root of a declared 'write' role. Never truncates or overwrites."""
+
+    def __init__(self, policy, role_name):
+        role = policy.role(role_name)
+        require(role.access == "write", "policy", "role %s is not a write role" % role.name)
+        self.policy, self.role = policy, role
+        self._fd = open_root(role.root)
+
+    def _parent(self, rel, e4=False, directory=False, e5=False):
+        require(self._fd is not None, "state", "writer closed")
+        if directory:
+            parts = check_rel(rel)
+            name_gate(self.role.root + "/" + rel, self.policy.host, self.role.grants)
+        else:
+            _, parts = _gate(self.policy, self.role.name, rel, "write", e4, e5=e5)
+        return open_dirs(self._fd, parts[:-1], "%s:%s" % (self.role.name, rel)), parts[-1]
+
+    def mkdir_excl(self, rel, mode=0o755):
+        parent, leaf = self._parent(rel, directory=True)
+        try:
+            mkdir_excl_at(parent, leaf, mode, "%s:%s" % (self.role.name, rel))
+        finally:
+            os.close(parent)
+
+    def open_excl(self, rel, e4=False, e5=False):
+        parent, leaf = self._parent(rel, e4=e4, e5=e5)
+        try:
+            fd = create_excl_at(parent, leaf, "%s:%s" % (self.role.name, rel))
+        except BaseException:
+            os.close(parent)
+            raise
+        return NewFile(fd, parent, self.role.max_size, "%s:%s" % (self.role.name, rel))
+
+    def create_excl(self, rel, data, mode=0o444):
+        require(isinstance(data, (bytes, bytearray)), "policy", "create_excl takes bytes")
+        out = self.open_excl(rel)
+        try:
+            out.write(bytes(data))
+        except BaseException:
+            out.abort()
+            raise
+        return out.finish(mode)
+
+    def write_json_once(self, rel, obj, mode=0o444):
+        data = (json.dumps(obj, sort_keys=True, indent=1, allow_nan=False) + "\n").encode()
+        return self.create_excl(rel, data, mode)
+
+    def publish_excl(self, tmp_rel, final_rel):
+        """No-clobber publication of a file this run created (replaces `tmp` + `mv`): tmp must be a regular file with
+        st_nlink == 1; linkat(tmp, final) fails if final exists in any form (never replaced); then tmp is unlinked."""
+        tparent, tleaf = self._parent(tmp_rel)
+        try:
+            fparent, fleaf = self._parent(final_rel)
+        except BaseException:
+            os.close(tparent)
+            raise
+        try:
+            try:
+                st = os.stat(tleaf, dir_fd=tparent, follow_symlinks=False)
+            except OSError as error:
+                refuse(_classify(error), "%s: %s" % (tmp_rel, os.strerror(error.errno)))
+            require(stat.S_ISREG(st.st_mode), "not-regular", "%s is not a regular file" % tmp_rel)
+            require(st.st_nlink == 1, "nlink", "%s is hard-linked (st_nlink %d)" % (tmp_rel, st.st_nlink))
+            try:
+                os.link(tleaf, fleaf, src_dir_fd=tparent, dst_dir_fd=fparent, follow_symlinks=False)
+            except FileExistsError:
+                refuse("exists", "%s:%s already exists (never replaced)" % (self.role.name, final_rel))
+            os.unlink(tleaf, dir_fd=tparent)
+            os.fsync(fparent)
+            os.fsync(tparent)
+        finally:
+            os.close(tparent)
+            os.close(fparent)
+
+    def create_e1_symlink(self):
+        """The one symlink this layer ever creates: E1 at the root of an E1 write role."""
+        require("E1" in self.role.exemptions, "exemption", "role %s has no E1 exemption" % self.role.name)
+        parent, leaf = self._parent(E1_ALIAS)
+        try:
+            try:
+                os.symlink(E1_LINK_TEXT, leaf, dir_fd=parent)
+            except FileExistsError:
+                refuse("exists", "E1 alias already exists")
+            os.fsync(parent)
+        finally:
+            os.close(parent)
+
+    def close(self):
+        if self._fd is not None:
+            fd, self._fd = self._fd, None
+            os.close(fd)
+
+    def __enter__(self):
+        return self
+
+    def __exit__(self, *exc):
+        self.close()
+        return False
+
+
+def utc_stamp():
+    return time.strftime("%Y%m%dT%H%M%SZ", time.gmtime())
+
+
+def write_refusal_receipt(writer, component, refusal, context=None):
+    """Write-once refusal receipt <COMPONENT>-REFUSAL-<utc>-<pid>-<hex>.json into a declared refusal role (the role
+    must declare a matching pattern). Returns the relative name."""
+    require(isinstance(component, str) and _COMPONENT.fullmatch(component) is not None, "policy", "bad component")
+    rel = "%s-REFUSAL-%s-%d-%s.json" % (component, utc_stamp(), os.getpid(), secrets.token_hex(4))
+    body = {"schema": REFUSAL_SCHEMA, "component": component, "utc": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
+            "pid": os.getpid(), "code": getattr(refusal, "code", "error"), "reason": str(refusal),
+            "context": context}
+    writer.write_json_once(rel, body)
+    return rel
+
+
+# ---------------------------------------------------------------------------------------------------------------------
+# Subprocess (item 8)
+# ---------------------------------------------------------------------------------------------------------------------
+LINGER_GRACE = 5.0
+
+
+class RunResult(object):
+    __slots__ = ("argv", "rc", "stdout", "stderr")
+
+    def __init__(self, argv, rc, stdout, stderr):
+        self.argv, self.rc, self.stdout, self.stderr = argv, rc, stdout, stderr
+
+
+def run_checked(argv, timeout, stdout_limit, stderr_limit=1 << 16, env=None, env_allow=(), stdin_bytes=None,
+                cwd=None, ok_rcs=(0,), stdin_break_ok_on_nonzero=False):
+    """Run an explicit argv (absolute argv[0], never a shell). `stdin_bytes` is bytes or an iterable of bytes chunks
+    (streamed; a Refusal raised by the iterable is re-raised after the child is reaped). The environment is exactly
+    `env` plus the listed `env_allow` names copied from os.environ. stdout/stderr are bounded (over-limit kills and refuses); a watchdog
+    kills the whole process group at `timeout`. Returns RunResult only if rc is in ok_rcs (default: 0); otherwise
+    Refusal('subprocess'), whatever stdout looked like."""
+    require(isinstance(argv, (list, tuple)) and argv and all(isinstance(a, str) and "\x00" not in a for a in argv),
+            "subprocess", "argv must be a non-empty list of strings")
+    require(argv[0].startswith("/") and os.path.normpath(argv[0]) == argv[0], "subprocess",
+            "argv[0] must be an absolute normalized path: %r" % argv[0])
+    require(isinstance(timeout, (int, float)) and timeout > 0, "subprocess", "timeout required")
+    require(type(stdout_limit) is int and stdout_limit > 0 and type(stderr_limit) is int and stderr_limit > 0,
+            "subprocess", "output limits required")
+    require(cwd is None or (isinstance(cwd, str) and cwd.startswith("/")), "subprocess", "cwd must be absolute")
+    require(all(isinstance(r, int) for r in ok_rcs) and ok_rcs, "subprocess", "ok_rcs must be ints")
+    full_env = {}
+    for key in env_allow:
+        if key in os.environ:
+            full_env[key] = os.environ[key]
+    for key, value in (env or {}).items():
+        require(isinstance(key, str) and isinstance(value, str), "subprocess", "env must map str to str")
+        full_env[key] = value
+    try:
+        proc = subprocess.Popen(list(argv), stdin=subprocess.PIPE if stdin_bytes is not None else subprocess.DEVNULL,
+                                stdout=subprocess.PIPE, stderr=subprocess.PIPE, env=full_env, cwd=cwd,
+                                start_new_session=True, close_fds=True, shell=False)
+    except OSError as error:
+        refuse("subprocess", "cannot start %s: %s" % (argv[0], error))
+    state = {"out": b"", "err": b"", "over": None, "timed_out": False, "stdin_error": None}
+
+    def kill():
+        try:
+            os.killpg(proc.pid, signal.SIGKILL)
+        except (ProcessLookupError, PermissionError):
+            pass
+
+    def drain(stream, key, limit):
+        chunks, total = [], 0
+        while True:
+            data = stream.read(65536) if not hasattr(stream, "read1") else stream.read1(65536)
+            if not data:
+                break
+            total += len(data)
+            if total > limit:
+                if state["over"] is None:
+                    state["over"] = key
+                    kill()
+                continue
+            chunks.append(data)
+        state[key] = b"".join(chunks)
+
+    def feed():
+        try:
+            if isinstance(stdin_bytes, (bytes, bytearray)):
+                proc.stdin.write(stdin_bytes)
+            else:
+                for chunk in stdin_bytes:
+                    proc.stdin.write(chunk)
+        except (BrokenPipeError, OSError, Refusal) as error:
+            state["stdin_error"] = error
+        finally:
+            try:
+                proc.stdin.close()
+            except (BrokenPipeError, OSError):
+                pass
+
+    def expire():
+        state["timed_out"] = True
+        kill()
+
+    threads = [threading.Thread(target=drain, args=(proc.stdout, "out", stdout_limit)),
+               threading.Thread(target=drain, args=(proc.stderr, "err", stderr_limit))]
+    if stdin_bytes is not None:
+        threads.append(threading.Thread(target=feed))
+    for t in threads:
+        t.daemon = True
+        t.start()
+    watchdog = threading.Timer(timeout, expire)
+    watchdog.daemon = True
+    watchdog.start()
+    try:
+        proc.wait()
+        for t in threads:
+            t.join(LINGER_GRACE)                         # output must close soon after the direct child exits
+        lingering = any(t.is_alive() for t in threads)
+        if lingering:
+            kill()
+            for t in threads:
+                t.join(5)
+    finally:
+        watchdog.cancel()
+    tail = state["err"][-400:].decode("utf-8", "replace")
+    require(not state["timed_out"], "subprocess", "%s timed out after %ss: %s" % (argv[0], timeout, tail))
+    require(state["over"] is None, "subprocess", "%s: %s exceeded its bound" % (argv[0], state["over"]))
+    require(not lingering, "subprocess", "%s: a descendant kept the output pipes open" % argv[0])
+    require(proc.returncode in ok_rcs, "subprocess", "%s exited %s (stdout discarded): %s"
+            % (argv[0], proc.returncode, tail))
+    if isinstance(state["stdin_error"], Refusal):
+        raise state["stdin_error"]
+    early_exit = stdin_break_ok_on_nonzero and proc.returncode != 0     # the child refused before reading it all
+    require(state["stdin_error"] is None or early_exit, "subprocess",
+            "%s: stdin feed failed: %s" % (argv[0], state["stdin_error"]))
+    return RunResult(tuple(argv), proc.returncode, state["out"], state["err"])
+
+
+_HOSTNAME = re.compile(r"[A-Za-z0-9][A-Za-z0-9.-]{0,252}\n")
+
+
+def hostname_checked(binary="/usr/bin/hostname", expected=None, timeout=10):
+    """rc 0 and exactly one hostname line, else Refusal. `expected` (short name) must match if given."""
+    result = run_checked([binary], timeout, 4096, env={"LC_ALL": "C"})
+    text = result.stdout.decode("ascii", "replace")
+    require(_HOSTNAME.fullmatch(text) is not None, "subprocess", "hostname output malformed: %r" % text[:80])
+    name = text.strip()
+    require(expected is None or name.split(".")[0] == expected, "subprocess",
+            "hostname %s is not %s" % (name, expected))
+    return name
+
+
+PS_FIELDS = ("pid", "ppid", "pgid", "sid", "uid")
+_PS_FIELD_RULES = {"pid": r"[0-9]+", "ppid": r"[0-9]+", "pgid": r"[0-9]+", "sid": r"[0-9]+", "uid": r"[0-9]+",
+                   "ni": r"-|-?[0-9]+", "cls": r"[A-Z?#-]{1,4}"}
+
+
+def ps_checked(binary="/usr/bin/ps", timeout=20, stdout_limit=8 << 20, fields=PS_FIELDS):
+    """Full process table (`ps -e -ww -o <fields>=,args=`; fields from pid ppid pgid sid uid ni cls, pid and ppid
+    required). rc must be 0; every line must parse; the table must contain this process with its real parent
+    (completeness check). Returns a list of dicts (integers for the id fields, strings for ni/cls/args)."""
+    fields = tuple(fields)
+    require(fields[:2] == ("pid", "ppid") and len(set(fields)) == len(fields)
+            and all(f in _PS_FIELD_RULES for f in fields), "subprocess", "bad ps fields %r" % (fields,))
+    spec = ",".join(f + "=" for f in fields) + ",args="
+    result = run_checked([binary, "-e", "-ww", "-o", spec], timeout, stdout_limit, env={"LC_ALL": "C"})
+    rows, n = [], len(fields)
+    for line in result.stdout.decode("utf-8", "replace").splitlines():
+        if not line.strip():
+            continue
+        parts = line.split(None, n)
+        require(len(parts) >= n and all(re.fullmatch(_PS_FIELD_RULES[f], v) for f, v in zip(fields, parts)),
+                "subprocess", "ps line malformed: %r" % line[:120])
+        row = {f: (v if f in ("ni", "cls") else int(v)) for f, v in zip(fields, parts)}
+        row["args"] = parts[n] if len(parts) > n else ""
+        rows.append(row)
+    me = [r for r in rows if r["pid"] == os.getpid()]
+    require(len(me) == 1 and me[0]["ppid"] == os.getppid(), "subprocess", "ps table incomplete (own process missing)")
+    return rows
+
+
+# ---------------------------------------------------------------------------------------------------------------------
+# Git: ONE helper for every git invocation (ruling P2-4, r2)
+# ---------------------------------------------------------------------------------------------------------------------
+GIT_BINARY = "/usr/bin/git"
+GIT_FIXED_ENV = {"LC_ALL": "C", "LANG": "C", "PATH": "/usr/bin:/bin", "GIT_CONFIG_NOSYSTEM": "1",
+                 "GIT_CONFIG_GLOBAL": "/dev/null", "GIT_ATTR_NOSYSTEM": "1", "GIT_NO_REPLACE_OBJECTS": "1",
+                 "GIT_OPTIONAL_LOCKS": "0", "GIT_TERMINAL_PROMPT": "0", "GIT_LITERAL_PATHSPECS": "1",
+                 "GIT_PAGER": "cat", "PAGER": "cat", "GIT_NO_LAZY_FETCH": "1", "GIT_ASKPASS": "/bin/false",
+                 "SSH_ASKPASS": "/bin/false"}
+GIT_ENV = GIT_FIXED_ENV                         # r1 name; HOME and XDG_CONFIG_HOME are added per call (fresh, empty)
+GIT_EXTRA_ENV_ALLOWED = ("GIT_AUTHOR_NAME", "GIT_AUTHOR_EMAIL", "GIT_AUTHOR_DATE", "GIT_COMMITTER_NAME",
+                         "GIT_COMMITTER_EMAIL", "GIT_COMMITTER_DATE", "TZ")
+GIT_GLOBAL_ARGS = ("--no-replace-objects", "--no-optional-locks", "-c", "core.hooksPath=/dev/null",
+                   "-c", "core.fsmonitor=false", "-c", "protocol.allow=never")
+GIT_SUBCOMMANDS = ("cat-file", "ls-tree", "rev-parse", "merge-base", "diff-tree", "ls-files", "status",
+                   "for-each-ref", "init", "fetch", "checkout", "add", "commit", "--version")
+# Repository-local config that can redirect or run code: driver sections (filter/diff/merge run commands from
+# porcelain), includes (pull in other files), and core keys that relocate the work tree or name commands.
+GIT_CONFIG_REFUSED_SECTIONS = ("filter", "diff", "merge", "include", "includeif")
+GIT_CONFIG_REFUSED_CORE_KEYS = ("worktree", "fsmonitor", "hookspath", "sshcommand", "gitproxy", "askpass",
+                                "editor", "pager", "alternaterefscommand", "alternaterefsprefixes", "attributesfile")
+GIT_PROTOCOLS = ("file",)
+GIT_ALLOW = ("alternates", "grafts", "shallow")
+GIT_INDIRECTIONS = (("alternates", ("objects", "info", "alternates")),
+                    ("alternates", ("objects", "info", "http-alternates")),
+                    ("grafts", ("info", "grafts")),
+                    ("shallow", ("shallow",)))
+GIT_COUNTERS = {"runs": 0, "object_reads": 0}  # instrumentation: tests prove refusal before the first object read
+_OID = re.compile(r"[0-9a-f]{40}|[0-9a-f]{64}")
+
+
+class GitRepo(object):
+    """A declared repository. Default: work_tree is a canonical checkout whose `.git` is a real directory (a gitfile,
+    a symlinked .git or a symlinked objects/ refuses). A linked/bare layout must declare git_dir (and common_dir when
+    git_dir holds a `commondir` file). Alternates, grafts and shallow files refuse unless listed in `allow`. Only the
+    protocols in `protocols` (subset of GIT_PROTOCOLS) are enabled; by default every transport is disabled."""
+    __slots__ = ("work_tree", "git_dir", "common_dir", "allow", "protocols")
+
+    def __init__(self, work_tree=None, git_dir=None, common_dir=None, allow=(), protocols=()):
+        require(work_tree is not None or git_dir is not None, "policy", "a work tree or a git dir is required")
+        for path in (work_tree, git_dir, common_dir):
+            if path is not None:
+                check_abs(path)
+        allow, protocols = frozenset(_names(allow, "allow")), tuple(sorted(set(_names(protocols, "protocols"))))
+        require(allow <= frozenset(GIT_ALLOW), "policy", "unknown git allowance %r" % (sorted(allow),))
+        require(set(protocols) <= set(GIT_PROTOCOLS), "policy", "unknown git protocol %r" % (protocols,))
+        object.__setattr__(self, "work_tree", work_tree)
+        object.__setattr__(self, "git_dir", git_dir if git_dir is not None else work_tree + "/.git")
+        object.__setattr__(self, "common_dir", common_dir)
+        object.__setattr__(self, "allow", allow)
+        object.__setattr__(self, "protocols", protocols)
+
+    def __setattr__(self, key, value):
+        refuse("policy", "GitRepo is immutable")
+
+
+def _as_repo(repo):
+    if isinstance(repo, GitRepo):
+        return repo
+    require(isinstance(repo, str), "policy", "repo must be a GitRepo or an absolute path")
+    return GitRepo(work_tree=repo)
+
+
+def _small_leaf(dir_fd, name, label, cap=4096):
+    fd, st = open_leaf(dir_fd, name, cap, None, label)
+    try:
+        chunks = []
+        read_exact(fd, st.st_size, chunks.append, label)
+    finally:
+        os.close(fd)
+    return b"".join(chunks)
+
+
+def _exists_nofollow(dir_fd, parts, label):
+    """True if parts (relative to dir_fd) exists in any form; directories on the way are opened no-follow."""
+    try:
+        parent = open_dirs(dir_fd, parts[:-1], label)
+    except Refusal as error:
+        if error.code == "missing":
+            return False
+        raise
+    try:
+        os.stat(parts[-1], dir_fd=parent, follow_symlinks=False)
+        return True
+    except FileNotFoundError:
+        return False
+    finally:
+        os.close(parent)
+
+
+def _check_git_config(dir_fd, name, label):
+    """Refuse a repository config file that declares GIT_CONFIG_REFUSED_SECTIONS or GIT_CONFIG_REFUSED_CORE_KEYS
+    (names only; values are not interpreted). Absent file: nothing to check."""
+    if not _exists_nofollow(dir_fd, [name], label):
+        return
+    text = _small_leaf(dir_fd, name, label + "/" + name, 1 << 20).decode("utf-8", "replace")
+    section = None
+    for line in text.splitlines():
+        line = line.strip()
+        if not line or line[0] in "#;":
+            continue
+        if line.startswith("["):
+            head = line[1:].split("]", 1)[0].strip()
+            section = head.split(None, 1)[0].split(".", 1)[0].strip('"').casefold()
+            require(section not in GIT_CONFIG_REFUSED_SECTIONS, "indirection", "%s/%s declares [%s]"
+                    % (label, name, head))
+            line = line.split("]", 1)[1].strip() if "]" in line else ""
+            if not line:
+                continue
+        key = line.split("=", 1)[0].strip().casefold()
+        require(not (section == "core" and key in GIT_CONFIG_REFUSED_CORE_KEYS), "indirection",
+                "%s/%s sets core.%s" % (label, name, key))
+
+
+def _git_preflight(repo, creating=False):
+    """Static repository indirection checks, before git runs: canonical work tree; a real git dir; a declared
+    common dir; objects/ a real directory; no alternates, grafts or shallow file unless declared in repo.allow; no
+    repository config that runs drivers, includes other files or relocates the work tree (_check_git_config)."""
+    if repo.work_tree is not None:
+        os.close(open_root(repo.work_tree))
+    if creating:
+        parent, leaf = repo.git_dir.rsplit("/", 1)
+        pfd = open_root(parent) if parent else os.open("/", DIR_FLAGS)
+        try:
+            require(not _exists_nofollow(pfd, [leaf], repo.git_dir), "exists", "git dir %s already exists"
+                    % repo.git_dir)
+        finally:
+            os.close(pfd)
+        return
+    gfd = open_root(repo.git_dir)
+    fds = [gfd]
+    try:
+        if _exists_nofollow(gfd, ["commondir"], repo.git_dir):
+            require(repo.common_dir is not None, "indirection", "%s has a commondir file but no common_dir was declared"
+                    % repo.git_dir)
+            text = _small_leaf(gfd, "commondir", repo.git_dir + "/commondir").decode("utf-8", "replace").strip()
+            target = os.path.normpath(text if text.startswith("/") else repo.git_dir + "/" + text)
+            require(target == repo.common_dir, "indirection", "commondir %r is not the declared %s"
+                    % (text, repo.common_dir))
+            fds.append(open_root(repo.common_dir))
+        else:
+            require(repo.common_dir is None, "indirection", "common_dir declared but %s has no commondir"
+                    % repo.git_dir)
+        os.close(open_dirs(fds[-1], ["objects"], repo.git_dir + " objects"))
+        for fd in fds:
+            _check_git_config(fd, "config", repo.git_dir)
+            _check_git_config(fd, "config.worktree", repo.git_dir)
+            for kind, parts in GIT_INDIRECTIONS:
+                if kind not in repo.allow and _exists_nofollow(fd, list(parts), repo.git_dir):
+                    refuse("indirection", "%s has %s (%s not declared)" % (repo.git_dir, "/".join(parts), kind))
+    finally:
+        for fd in fds:
+            os.close(fd)
+
+
+def git_run(repo, args, timeout=120, stdout_limit=64 << 20, stdin_bytes=None, ok_rcs=(0,), extra_env=None,
+            git_binary=GIT_BINARY):
+    """THE git helper. Every git invocation in this layer goes through it:
+    * environment = GIT_FIXED_ENV + a fresh empty HOME (XDG_CONFIG_HOME inside it) + allowlisted extra_env keys;
+      nothing is inherited (no GIT_DIR / GIT_OBJECT_DIRECTORY / GIT_ALTERNATE_OBJECT_DIRECTORIES / GIT_INDEX_FILE /
+      GIT_CONFIG_* / GIT_REPLACE_REF_BASE ...);
+    * --no-replace-objects and GIT_NO_REPLACE_OBJECTS=1; -c core.hooksPath=/dev/null; core.fsmonitor=false;
+      protocol.allow=never (plus the repo's declared protocols); GIT_OPTIONAL_LOCKS=0;
+    * explicit --git-dir (and --work-tree when declared), after the static _git_preflight;
+    * an allowlisted subcommand; rc must be in ok_rcs (default 0) before stdout is visible; bounded output."""
+    repo = _as_repo(repo)
+    require(isinstance(args, (list, tuple)) and args and all(isinstance(a, str) and "\x00" not in a for a in args),
+            "subprocess", "git args must be a non-empty list of strings")
+    require(args[0] in GIT_SUBCOMMANDS, "subprocess", "git subcommand %r is not allowed" % (args[0],))
+    _git_preflight(repo, creating=args[0] == "init")
+    env = dict(GIT_FIXED_ENV)
+    for key, value in sorted((extra_env or {}).items()):
+        require(key in GIT_EXTRA_ENV_ALLOWED and isinstance(value, str), "subprocess", "git env %r not allowed" % key)
+        env[key] = value
+    argv = [git_binary] + list(GIT_GLOBAL_ARGS)
+    for proto in repo.protocols:
+        argv += ["-c", "protocol.%s.allow=always" % proto]
+    argv.append("--git-dir=" + repo.git_dir)
+    if repo.work_tree is not None:
+        argv.append("--work-tree=" + repo.work_tree)
+    home = tempfile.mkdtemp(prefix="si-git-home-")
+    env["HOME"], env["XDG_CONFIG_HOME"] = home, home + "/xdg-config-absent"
+    GIT_COUNTERS["runs"] += 1
+    leftover = False
+    try:
+        result = run_checked(argv + list(args), timeout, stdout_limit, env=env, stdin_bytes=stdin_bytes,
+                             cwd=repo.work_tree or repo.git_dir, ok_rcs=ok_rcs)
+    finally:
+        try:
+            os.rmdir(home)
+        except OSError:
+            leftover = True
+    require(not leftover, "subprocess", "git wrote into its empty HOME %s (kept)" % home)
+    return result
+
+
+def git_checked(repo, args, git_binary=GIT_BINARY, timeout=120, stdout_limit=64 << 20, stdin_bytes=None):
+    """r1 name: git_run with rc 0 required."""
+    return git_run(repo, args, timeout, stdout_limit, stdin_bytes, git_binary=git_binary)
+
+
+def _git_object(repo, oid, kind, size, label, git_binary=GIT_BINARY, timeout=120):
+    """The ONLY object-content read: `cat-file --batch` for one object. The reply header must be exactly
+    '<oid> <kind> <size>' of the expected tree entry, the body exactly size bytes plus LF, and the body must re-hash
+    to oid, all before the bytes are returned to any caller."""
+    require(isinstance(oid, str) and _OID.fullmatch(oid) is not None, "git", "%s: bad object id" % label)
+    require(kind in ("blob", "tree", "commit", "tag") and type(size) is int and size >= 0, "git",
+            "%s: bad expected object" % label)
+    GIT_COUNTERS["object_reads"] += 1
+    header = ("%s %s %d" % (oid, kind, size)).encode()
+    out = git_run(repo, ["cat-file", "--batch"], timeout, len(header) + size + 2, (oid + "\n").encode(),
+                  git_binary=git_binary).stdout
+    nl = out.find(b"\n")
+    require(nl >= 0 and out[:nl] == header, "git", "%s: object header %r is not %r" % (label, out[:nl][:120], header))
+    body = out[nl + 1:]
+    require(len(body) == size + 1 and body.endswith(b"\n"), "size", "%s: object body is not %d bytes" % (label, size))
+    data = body[:-1]
+    algo = hashlib.sha1 if len(oid) == 40 else hashlib.sha256
+    require(algo(b"%s %d\x00" % (kind.encode(), size) + data).hexdigest() == oid, "sha",
+            "%s: object bytes do not hash to %s" % (label, oid))
+    return data
+
+
+def _git_commit(repo, commit, git_binary, timeout):
+    require(isinstance(commit, str) and _OID.fullmatch(commit) is not None, "subprocess",
+            "commit must be a full object id")
+    kind = git_run(repo, ["cat-file", "-t", commit], timeout, 64, git_binary=git_binary).stdout
+    require(kind == b"commit\n", "git", "%s is a %r, not a commit" % (commit[:12], kind[:20]))
+
+
+_LS_TREE = re.compile(r"([0-7]{6}) (blob|tree|commit) ([0-9a-f]{40}|[0-9a-f]{64}) +(-|[0-9]+)\t(.+)", re.S)
+
+
+def _parse_ls_tree(raw):
+    require(raw == b"" or raw.endswith(b"\x00"), "subprocess", "ls-tree output not NUL-terminated")
+    entries = []
+    for record in raw.split(b"\x00")[:-1]:
+        try:
+            text = record.decode("utf-8")
+        except UnicodeDecodeError:
+            refuse("path", "non-UTF-8 tracked path")
+        match = _LS_TREE.fullmatch(text)
+        require(match is not None, "subprocess", "ls-tree record malformed: %r" % text[:120])
+        mode, kind, oid, size, path = match.groups()
+        entries.append({"mode": mode, "type": kind, "oid": oid, "size": None if size == "-" else int(size),
+                        "path": path})
+    return entries
+
+
+def git_ls_tree(repo, commit, git_binary=GIT_BINARY, timeout=300, stdout_limit=256 << 20):
+    """Phase 1 input: `git ls-tree -r -l -z --full-tree <commit>` (the commit's type checked first) parsed strictly
+    into [{mode,type,oid,size,path}]. Metadata only: no object content is read."""
+    _git_commit(repo, commit, git_binary, timeout)
+    return _parse_ls_tree(git_run(repo, ["ls-tree", "-r", "-l", "-z", "--full-tree", commit], timeout, stdout_limit,
+                                  git_binary=git_binary).stdout)
+
+
+def git_show_file(policy, role_name, repo, commit, rel, max_size=None, expected_sha256=None,
+                  git_binary=GIT_BINARY, timeout=120):
+    """`git show <commit>:<rel>` through the gate: the role root must BE the repository; names and allowlist are
+    checked first (no git call for a forbidden name); the tree entry must be exactly one regular blob within the
+    cap (a tracked symlink or E4 receipt is refused); the bytes are read by _git_object (type/size/OID) and must
+    match expected_sha256 when given."""
+    role = policy.role(role_name)
+    repo = _as_repo(repo)
+    require(role.root == (repo.work_tree or repo.git_dir), "root", "role %s is not rooted at the repository %s"
+            % (role.name, repo.work_tree or repo.git_dir))
+    _gate(policy, role_name, rel, role.access)
+    cap = role.max_size if max_size is None else min(role.max_size, max_size)
+    _git_commit(repo, commit, git_binary, timeout)
+    raw = git_run(repo, ["ls-tree", "-l", "-z", "--full-tree", commit, "--", rel], timeout, 1 << 16,
+                  git_binary=git_binary).stdout
+    records = [r for r in raw.split(b"\x00") if r]
+    require(records, "missing", "%s is not tracked at %s" % (rel, commit[:12]))
+    match = _LS_TREE.fullmatch(records[0].decode("utf-8", "replace"))
+    require(len(records) == 1 and match is not None and match.group(5) == rel, "subprocess",
+            "ls-tree did not return exactly %s" % rel)
+    mode, kind, oid, size = match.group(1), match.group(2), match.group(3), match.group(4)
+    require(kind == "blob" and mode != "120000", "symlink" if mode == "120000" else "not-regular",
+            "tracked %s is not a regular blob (mode %s)" % (rel, mode))
+    require(mode in ("100644", "100755"), "not-regular", "tracked %s has mode %s" % (rel, mode))
+    require(int(size) <= cap, "size", "tracked %s is %s bytes (cap %d)" % (rel, size, cap))
+    data = _git_object(repo, oid, "blob", int(size), rel, git_binary, timeout)
+    require(expected_sha256 is None or hashlib.sha256(data).hexdigest() == expected_sha256, "sha",
+            "tracked %s SHA-256 mismatch" % rel)
+    return data
+
+
+def _is_member(members, entry, paths):
+    if members is None:
+        return True
+    if callable(members):
+        return members(dict(entry)) is True
+    return entry["path"] in paths
+
+
+def _screen_tree(policy, role_name, entries, members=None):
+    """Phase 1, pure (no git, no syscall): screens ALL tree metadata to completion and returns the plan dict, or
+    refuses the whole tree. Every entry: syntax, duplicates, and the E4 fail-closed rule (any component exactly
+    complete.json must be an exact E4 path, mode 100644, pinned blob OID). Members (all entries when members is
+    None; else the caller's frozen predicate or exact name list, decided from metadata alone; non-members are never
+    read): family denylist + allowlist (E-list exceptions only), blob type, mode 100644/100755, cap; the exact E1
+    entry (mode 120000, oid E1_LINK_OID); E4 pins; E5 members of an E5 role (exact path, mode 100644, blob OID equal
+    to E5_RUNTIME_MEMBERS, cap); the E1 target present and screened like a member."""
+    role = policy.role(role_name)
+    paths = None
+    if members is not None and not callable(members):
+        paths = frozenset(_names(members, "members"))
+    seen, by_path = set(), {}
+    for entry in entries:
+        path = entry["path"]
+        check_rel(path)
+        require(path not in seen, "path", "duplicate tree path %s" % path)
+        seen.add(path)
+        by_path[path] = entry
+        if any(c.casefold() == E4_LEAF for c in path.split("/")):
+            require(path in E4_COMPLETE_JSON, "name", "tracked complete.json outside the exact E4 list: %s" % path)
+            require(entry["type"] == "blob" and entry["mode"] == "100644" and entry["oid"] == E4_GIT_BLOB_OIDS[path],
+                    "exemption", "E4 entry %s is not the pinned 100644 blob" % path)
+    if paths is not None:
+        missing = sorted(paths - seen)
+        require(not missing, "missing", "declared members not in the tree: %s" % missing[:5])
+    files, e4, e5, e1 = [], [], [], None
+    for entry in entries:
+        if not _is_member(members, entry, paths):
+            continue
+        path, mode = entry["path"], entry["mode"]
+        is_e4 = "E4" in role.exemptions and path in E4_COMPLETE_JSON
+        is_e5 = "E5" in role.exemptions and e5_blob_oid(path) is not None
+        _gate(policy, role_name, path, role.access, e4=is_e4, e5=is_e5)
+        require(entry["type"] == "blob", "not-regular", "tree entry %s is a %s" % (path, entry["type"]))
+        if is_e5:
+            require(mode == "100644" and entry["oid"] == e5_blob_oid(path), "exemption",
+                    "E5 entry %s is not the pinned 100644 blob" % path)
+            require(entry["size"] is not None and entry["size"] <= role.max_size, "size", "blob %s too large" % path)
+            e5.append(entry)
+            continue
+        if mode == "120000":
+            require("E1" in role.exemptions and path == E1_ALIAS, "symlink", "tracked symlink %s refused" % path)
+            require(entry["oid"] == E1_LINK_OID and entry["size"] == len(E1_LINK_TEXT), "exemption",
+                    "E1 entry is not the exact link to %s" % E1_LINK_TEXT)
+            e1 = entry
+            continue
+        require(mode in ("100644", "100755"), "not-regular", "tree entry %s has mode %s" % (path, mode))
+        require(entry["size"] is not None and entry["size"] <= role.max_size, "size", "blob %s too large" % path)
+        (e4 if is_e4 else files).append(entry)
+    target = None
+    if e1 is not None:
+        target = by_path.get(E1_LINK_TEXT)
+        require(target is not None, "exemption", "E1 target not in the tree")
+        if not any(f is target for f in files):
+            _gate(policy, role_name, E1_LINK_TEXT, role.access)
+            require(target["type"] == "blob" and target["mode"] in ("100644", "100755") and target["size"] is not None
+                    and target["size"] <= role.max_size, "exemption", "E1 target is not a regular blob within the cap")
+    return {"files": files, "e1": e1, "e1_target": target, "e4": e4, "e5": e5, "role": role.name}
+
+
+def gate_git_tree(policy, role_name, entries):
+    """r1 API: _screen_tree over the WHOLE tree (every entry is a member). Pure; before any blob is read."""
+    return _screen_tree(policy, role_name, entries, None)
+
+
+def git_blob(repo, plan, entry, git_binary=GIT_BINARY, timeout=120):
+    """Bytes of one planned ordinary file blob or of the planned E1 target (never an E4 entry); the E1 link entry
+    returns its verified link text."""
+    if plan["e1"] is not None and entry is plan["e1"]:
+        data = _git_object(repo, entry["oid"], "blob", entry["size"], entry["path"], git_binary, timeout)
+        require(data == E1_LINK_TEXT.encode(), "exemption", "E1 tracked link text differs")
+        return data
+    require(any(entry is f for f in plan["files"]) or (plan.get("e1_target") is not None and entry is plan["e1_target"]),
+            "policy", "entry %s is not a planned file" % entry.get("path"))
+    return _git_object(repo, entry["oid"], "blob", entry["size"], entry["path"], git_binary, timeout)
+
+
+def git_hash_e4(repo, plan, entry, git_binary=GIT_BINARY, timeout=120):
+    """E4 through git: exact path, pinned blob OID (checked in phase 1 and by _git_object) and SHA-256, or refuse;
+    returns {path, sha256, size}, never the bytes."""
+    require(any(entry is f for f in plan["e4"]), "exemption", "entry is not a planned E4 entry")
+    data = _git_object(repo, entry["oid"], "blob", entry["size"], entry["path"], git_binary, timeout)
+    digest = hashlib.sha256(data).hexdigest()
+    require(digest == E4_COMPLETE_JSON[entry["path"]], "exemption", "E4 SHA mismatch for %s" % entry["path"])
+    return {"path": entry["path"], "sha256": digest, "size": len(data)}
+
+
+def git_hash_e5(repo, plan, entry, git_binary=GIT_BINARY, timeout=120):
+    """E5 through git: a planned E5 entry (exact path, mode 100644 and pinned blob OID, all checked in phase 1),
+    read by _git_object (which re-hashes the bytes to that OID); returns {path, git_oid, sha256, size}, never the
+    bytes."""
+    require(any(entry is f for f in plan["e5"]), "exemption", "entry is not a planned E5 entry")
+    data = _git_object(repo, entry["oid"], "blob", entry["size"], entry["path"], git_binary, timeout)
+    return {"path": entry["path"], "git_oid": entry["oid"], "sha256": hashlib.sha256(data).hexdigest(),
+            "size": len(data)}
+
+
+def git_e1_check(repo, plan, git_binary=GIT_BINARY, timeout=120):
+    """D2, committed side: the plan's E1 entry is the exact mode-120000 link (oid E1_LINK_OID, checked in phase 1)
+    whose link blob, read with cat-file (never followed), is exactly E1_LINK_TEXT; the target is a screened regular
+    blob. Returns {alias, link, target, target_oid, target_sha256, target_size}."""
+    require(plan["e1"] is not None and plan["e1"]["mode"] == "120000", "exemption", "the plan has no E1 entry")
+    git_blob(repo, plan, plan["e1"], git_binary, timeout)
+    data = git_blob(repo, plan, plan["e1_target"], git_binary, timeout)
+    return {"alias": E1_ALIAS, "link": E1_LINK_TEXT, "target": E1_LINK_TEXT, "target_oid": plan["e1_target"]["oid"],
+            "target_sha256": hashlib.sha256(data).hexdigest(), "target_size": len(data)}
+
+
+def git_e1_verify_shipped(repo, plan, policy, role_name, git_binary=GIT_BINARY, timeout=120):
+    """D2, shipped side: the runtime's visualize_battle.py must be a regular file (never a symlink; st_nlink 1, via
+    the descriptor gate) whose bytes equal the gated E1 target blob. Returns git_e1_check() plus shipped_sha256."""
+    info = git_e1_check(repo, plan, git_binary, timeout)
+    shipped = sha256_input(policy, role_name, E1_ALIAS, expected_size=info["target_size"])
+    require(shipped["sha256"] == info["target_sha256"], "exemption",
+            "shipped %s differs from the committed E1 target blob" % E1_ALIAS)
+    info["shipped_sha256"] = shipped["sha256"]
+    return info
+
+
+def git_export(repo, plan, writer, e1_mode="copy", git_binary=GIT_BINARY, timeout=120):
+    """Export a screened plan into a Writer (same relative paths; directories created exclusively). Ordinary members
+    are read one at a time (type/size/OID verified). E4 entries are carried after their pin check without returning
+    bytes; E5 entries (pinned in phase 1, OID re-verified by _git_object) are carried byte-exact as 0444 files. E1 is
+    MATERIALISED (ruling D2): a regular file at visualize_battle.py whose bytes are the verified target
+    blob; e1_mode must be 'copy' (r1's 'symlink' mode is withdrawn by D2). Returns {path: {sha256, size}}."""
+    require(e1_mode == "copy", "exemption", "ruling D2: E1 is materialised; e1_mode must be 'copy'")
+    made, inventory = set(), {}
+
+    def ensure_dirs(path):
+        parts = path.split("/")[:-1]
+        for i in range(len(parts)):
+            rel = "/".join(parts[:i + 1])
+            if rel not in made:
+                writer.mkdir_excl(rel)
+                made.add(rel)
+
+    for entry in plan["files"]:
+        data = git_blob(repo, plan, entry, git_binary, timeout)
+        ensure_dirs(entry["path"])
+        inventory[entry["path"]] = writer.create_excl(entry["path"], data,
+                                                      0o555 if entry["mode"] == "100755" else 0o444)
+    for entry in plan["e4"]:
+        data = _git_object(repo, entry["oid"], "blob", entry["size"], entry["path"], git_binary, timeout)
+        require(hashlib.sha256(data).hexdigest() == E4_COMPLETE_JSON[entry["path"]], "exemption",
+                "E4 SHA mismatch for %s" % entry["path"])
+        ensure_dirs(entry["path"])
+        out = writer.open_excl(entry["path"], e4=True)
+        try:
+            out.write(data)
+        except BaseException:
+            out.abort()
+            raise
+        inventory[entry["path"]] = out.finish(0o444)
+        del data
+    for entry in plan["e5"]:
+        data = _git_object(repo, entry["oid"], "blob", entry["size"], entry["path"], git_binary, timeout)
+        ensure_dirs(entry["path"])
+        out = writer.open_excl(entry["path"], e5=True)
+        try:
+            out.write(data)
+        except BaseException:
+            out.abort()
+            raise
+        inventory[entry["path"]] = out.finish(0o444)
+        del data
+    if plan["e1"] is not None:
+        info = git_e1_check(repo, plan, git_binary, timeout)
+        data = git_blob(repo, plan, plan["e1_target"], git_binary, timeout)
+        result = writer.create_excl(E1_ALIAS, data, 0o444)
+        require(result["sha256"] == info["target_sha256"], "exemption", "E1 materialised copy differs")
+        result["copy_of"] = E1_LINK_TEXT
+        inventory[E1_ALIAS] = result
+    return inventory
+
+
+class GitPlan(object):
+    """The two-phase tree-then-blob API. git_plan() is phase 1: ls-tree metadata of one commit, screened to
+    completion (see _screen_tree); it reads no object content. Only the methods below (phase 2) read objects, only
+    for planned entries, each through _git_object (type/size/OID verified before bytes are returned)."""
+
+    def __init__(self, repo, commit, plan, git_binary, timeout):
+        self.repo, self.commit, self._plan = repo, commit, plan
+        self._git, self._timeout = git_binary, timeout
+
+    @property
+    def files(self):
+        return list(self._plan["files"])
+
+    @property
+    def e4(self):
+        return list(self._plan["e4"])
+
+    @property
+    def e5(self):
+        return list(self._plan["e5"])
+
+    @property
+    def e1(self):
+        return self._plan["e1"]
+
+    def entry(self, path):
+        hits = [f for f in self._plan["files"] if f["path"] == path]
+        require(len(hits) == 1, "policy", "%s is not a planned member" % path)
+        return hits[0]
+
+    def read(self, entry_or_path, expected_sha256=None):
+        entry = self.entry(entry_or_path) if isinstance(entry_or_path, str) else entry_or_path
+        data = git_blob(self.repo, self._plan, entry, self._git, self._timeout)
+        require(expected_sha256 is None or hashlib.sha256(data).hexdigest() == expected_sha256, "sha",
+                "%s SHA-256 mismatch" % entry["path"])
+        return data
+
+    def hash_e4(self, entry):
+        return git_hash_e4(self.repo, self._plan, entry, self._git, self._timeout)
+
+    def hash_e5(self, entry):
+        return git_hash_e5(self.repo, self._plan, entry, self._git, self._timeout)
+
+    def e1_check(self):
+        return git_e1_check(self.repo, self._plan, self._git, self._timeout)
+
+    def e1_verify_shipped(self, policy, role_name):
+        return git_e1_verify_shipped(self.repo, self._plan, policy, role_name, self._git, self._timeout)
+
+    def export(self, writer):
+        return git_export(self.repo, self._plan, writer, "copy", self._git, self._timeout)
+
+
+def git_plan(policy, role_name, repo, commit, members=None, git_binary=GIT_BINARY, timeout=300):
+    """Phase 1 (and the D1 member helper): metadata of `commit` through the git helper, then _screen_tree with the
+    caller's frozen membership (None = whole tree; an exact path collection; or a predicate over metadata dicts).
+    The role root must be the repository. Returns a GitPlan; no object content has been read."""
+    role = policy.role(role_name)
+    repo = _as_repo(repo)
+    require(role.root == (repo.work_tree or repo.git_dir), "root", "role %s is not rooted at the repository %s"
+            % (role.name, repo.work_tree or repo.git_dir))
+    entries = git_ls_tree(repo, commit, git_binary, timeout)
+    return GitPlan(repo, commit, _screen_tree(policy, role_name, entries, members), git_binary, timeout)
+
