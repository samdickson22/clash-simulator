+MAX_MANIFEST = 32 << 20
+MAX_FILES = 200000
+MAX_TOTAL = 64 << 30
+FILE_MODES = (0o444, 0o555)
+REQUEST_KEYS = ["dirs", "files", "grants", "host", "max_total", "root", "schema"]
+FILE_KEYS = ["e4", "e5", "mode", "rel", "sha256", "size"]
+SHA_RE = re.compile(r"[0-9a-f]{64}")
+
+
+def _emit(obj, rc):
+    data = (json.dumps(obj, sort_keys=True, separators=(",", ":")) + "\n").encode()
+    view = memoryview(data)
+    while view:
+        view = view[os.write(1, view):]
+    os._exit(rc)
+
+
+def _no_dups(pairs):
+    out = {}
+    for key, value in pairs:
+        if key in out:
+            refuse("request", "duplicate key")
+        out[key] = value
+    return out
+
+
+def _no_constant(name):
+    refuse("request", "non-finite constant")
+
+
+def _take(stream, n, what):
+    data = stream.read(n)
+    if len(data) != n:
+        refuse("stream", "%s: the stream ended early" % what)
+    return data
+
+
+def _parent(rel):
+    return rel.rsplit("/", 1)[0] if "/" in rel else ""
+
+
+def validate_receive(req):
+    """Strict manifest validation (shared verbatim with the local sender): exact keys and types; normalized relative
+    names (no '', '.', '..', absolute, NUL/control/backslash); no duplicate (also casefold-duplicate) names; every
+    directory's and file's parent is the root or an EARLIER declared directory; modes 0444/0555; sizes within
+    max_total; E4 files only at exact E4 paths with the pinned SHA-256; E5 files only at exact E5 paths, mode 0444
+    (their bytes must hash to the pinned blob OID while received)."""
+    if not isinstance(req, dict) or sorted(req) != REQUEST_KEYS:
+        refuse("request", "bad receive request keys")
+    if req["schema"] != RECEIVE_SCHEMA or req["host"] not in HOSTS:
+        refuse("request", "bad schema or host")
+    check_abs(req["root"])
+    if not isinstance(req["grants"], list) or not set(req["grants"]) <= set(GRANTS):
+        refuse("request", "bad grants")
+    if type(req["max_total"]) is not int or not 0 <= req["max_total"] <= MAX_TOTAL:
+        refuse("request", "bad max_total")
+    dirs, files = req["dirs"], req["files"]
+    if not isinstance(dirs, list) or not isinstance(files, list) or len(dirs) + len(files) > MAX_FILES:
+        refuse("request", "bad dirs/files")
+    names, folded, made, total = set(), set(), set(), 0
+    for rel in dirs + [f.get("rel") if isinstance(f, dict) else None for f in files]:
+        check_rel(rel)
+        if rel in names or rel.casefold() in folded:
+            refuse("request", "duplicate name %r" % rel)
+        names.add(rel)
+        folded.add(rel.casefold())
+    for rel in dirs:
+        if _parent(rel) not in made and _parent(rel) != "":
+            refuse("request", "directory %r before its parent" % rel)
+        made.add(rel)
+    for f in files:
+        if sorted(f) != FILE_KEYS:
+            refuse("request", "bad file keys")
+        if _parent(f["rel"]) != "" and _parent(f["rel"]) not in made:
+            refuse("request", "file %r outside the declared directories" % f["rel"])
+        if type(f["size"]) is not int or f["size"] < 0 or not isinstance(f["sha256"], str) \
+                or SHA_RE.fullmatch(f["sha256"]) is None or f["mode"] not in FILE_MODES or f["e4"] not in (True, False) \
+                or type(f["e5"]) is not bool:
+            refuse("request", "bad file record %r" % f["rel"])
+        if f["e4"] and E4_COMPLETE_JSON.get(f["rel"]) != f["sha256"]:
+            refuse("exemption", "E4 is an exact path with its pinned SHA-256: %r" % f["rel"])
+        if f["e5"] and (f["e4"] or f["mode"] != 0o444 or e5_blob_oid(f["rel"]) is None):
+            refuse("exemption", "E5 is an exact E5 path with mode 0444: %r" % f["rel"])
+        total += f["size"]
+    if total > req["max_total"]:
+        refuse("size", "files exceed max_total")
+    return dirs, files
+
+
+def main():
+    status = {"manifest_sha256": None, "host": None, "where": None, "created": []}
+    try:
+        if len(sys.argv) != 4 or SHA_RE.fullmatch(sys.argv[3]) is None:
+            refuse("request", "expected <program-length> <program-sha256> <manifest-sha256>")
+        stream = sys.stdin.buffer
+        size = int.from_bytes(_take(stream, 8, "manifest length"), "big")
+        if not 0 < size <= MAX_MANIFEST:
+            refuse("request", "bad manifest length")
+        raw = _take(stream, size, "manifest")
+        status["manifest_sha256"] = hashlib.sha256(raw).hexdigest()
+        if status["manifest_sha256"] != sys.argv[3]:
+            refuse("request", "manifest SHA-256 differs from the argv commitment")
+        try:
+            req = json.loads(raw.decode("utf-8"), object_pairs_hook=_no_dups, parse_constant=_no_constant)
+        except ValueError:
+            refuse("request", "manifest is not JSON")
+        dirs, files = validate_receive(req)
+        host, root, grants = req["host"], req["root"], req["grants"]
+        # 1. every name gate, before any syscall
+        name_gate(root, host, grants)
+        for rel in dirs:
+            name_gate(root + "/" + rel, host, grants)
+        for f in files:
+            name_gate(root + "/" + f["rel"], host, grants, e4_leaf=f["e4"], e5_rel=f["rel"] if f["e5"] else None)
+        # 2. this host
+        node = os.uname().nodename.split(".")[0]
+        status["host"] = node
+        if node != host:
+            refuse("host", "request for %s ran on %s" % (host, node))
+        # 3. the destination root is created exclusively under its canonical parent; everything else inside it
+        parent, top = root.rsplit("/", 1)
+        status["where"] = ""
+        pfd = open_root(parent) if parent else os.open("/", DIR_FLAGS)
+        try:
+            mkdir_excl_at(pfd, top, 0o755, root)
+        finally:
+            os.close(pfd)
+        status["created"].append("")
+        rfd = open_root(root)
+        try:
+            for rel in dirs:
+                status["where"] = rel
+                parts = rel.split("/")
+                pfd = open_dirs(rfd, parts[:-1], root)
+                try:
+                    mkdir_excl_at(pfd, parts[-1], 0o755, rel)
+                finally:
+                    os.close(pfd)
+                status["created"].append(rel)
+            out = []
+            for f in files:
+                status["where"] = f["rel"]
+                parts = f["rel"].split("/")
+                pfd = open_dirs(rfd, parts[:-1], root)
+                try:
+                    fd = create_excl_at(pfd, parts[-1], f["rel"])
+                    status["created"].append(f["rel"])
+                    digest, left = hashlib.sha256(), f["size"]
+                    blob = hashlib.sha1(b"blob %d\x00" % f["size"])
+                    try:
+                        while left:
+                            chunk = stream.read(min(CHUNK, left))
+                            if not chunk:
+                                refuse("stream", "the stream ended inside %s (partial kept)" % f["rel"])
+                            view = memoryview(chunk)
+                            while view:
+                                view = view[os.write(fd, view):]
+                            digest.update(chunk)
+                            blob.update(chunk)
+                            left -= len(chunk)
+                        os.fsync(fd)
+                        os.fchmod(fd, f["mode"])
+                        now = os.fstat(fd)
+                    finally:
+                        os.close(fd)
+                    os.fsync(pfd)
+                finally:
+                    os.close(pfd)
+                if digest.hexdigest() != f["sha256"]:
+                    refuse("sha", "%s: received bytes do not match the manifest SHA-256 (partial kept)" % f["rel"])
+                if f["e5"] and blob.hexdigest() != e5_blob_oid(f["rel"]):
+                    refuse("exemption", "%s: received bytes do not hash to the E5 blob OID (partial kept)" % f["rel"])
+                if not stat.S_ISREG(now.st_mode) or now.st_nlink != 1 or now.st_size != f["size"]:
+                    refuse("changed", "%s: created file is not a single-link regular file of its size" % f["rel"])
+                out.append({"rel": f["rel"], "size": now.st_size, "sha256": f["sha256"], "nlink": now.st_nlink,
+                            "mode": now.st_mode, "dev": now.st_dev, "ino": now.st_ino})
+            status["where"] = None
+            if stream.read(1):
+                refuse("stream", "extra bytes after the last file")
+            os.fsync(rfd)
+        finally:
+            os.close(rfd)
+        _emit({"schema": RECEIPT_SCHEMA, "status": "ok", "host": node, "manifest_sha256": status["manifest_sha256"],
+               "root": root, "dirs": dirs, "files": out}, 0)
+    except Refusal as error:
+        _emit({"schema": RECEIPT_SCHEMA, "status": "refused", "host": status["host"],
+               "manifest_sha256": status["manifest_sha256"], "code": error.code, "reason": error.reason,
+               "where": status["where"], "created": status["created"]}, 3)
+    except Exception as error:
+        _emit({"schema": RECEIPT_SCHEMA, "status": "error", "host": status["host"],
+               "manifest_sha256": status["manifest_sha256"], "code": "error", "reason": type(error).__name__,
+               "where": status["where"], "created": status["created"]}, 4)
+
+
+if __name__ == "__main__":
+    main()
+'''
+
+_RECEIVE_NS = dict(globals())                       # this module's _CORE names (one Refusal class)
+exec(compile(_RECEIVE_MAIN.replace('\nif __name__ == "__main__":\n    main()\n', "\n"), "<safe_input receive>", "exec"),
+     _RECEIVE_NS)                                    # validate_receive() is shared verbatim with the local sender
+
+RECEIVE_REQUEST_SCHEMA = "clasher.k4s.safe-input.receive-request.v1"
+RECEIVE_RECEIPT_SCHEMA = "clasher.k4s.safe-input.receive-receipt.v1"
+# The one fixed remote word that is not [A-Za-z0-9/-]: a constant bootstrap (no single quote inside) that reads
+# exactly <len> program bytes from stdin, refuses (exit 4) unless they hash to the argv SHA-256, then runs them; the
+# program keeps reading the framed stream from the same stdin buffer.
+RECEIVE_BOOTSTRAP = ('import sys,hashlib;b=sys.stdin.buffer.read(int(sys.argv[1]));'
+                     'hashlib.sha256(b).hexdigest()==sys.argv[2] or sys.exit(4);'
+                     'exec(compile(b,"<k4s-safe-input-receive>","exec"))')
+
+
+def receive_program_source():
+    """The exact receive program run on the host: _CORE + the receive main (python3.8 stdlib)."""
+    return "# k4s safe_input remote receiver r2 (stdlib only, python3.8+, create-only)\n" + _CORE + _RECEIVE_MAIN
+
+
+def receive_program_sha256():
+    return hashlib.sha256(receive_program_source().encode()).hexdigest()
+
+
+def build_receive_manifest(policy, role_name, dirs, files, max_total):
+    """Canonical manifest bytes for remote_receive. The remote Policy's write role root is the destination root the
+    receiver will CREATE (its parent must exist). Every name is gated locally first (never sent if forbidden):
+    dirs via name_gate, files via the role gate (allowlist, E4/E5 only for an E4/E5 role at an exact path)."""
+    require(isinstance(policy, Policy) and policy.remote, "policy", "a remote Policy is required")
+    role = policy.role(role_name)
+    require(role.access == "write", "policy", "role %s is not a write role" % role.name)
+    require(isinstance(dirs, (list, tuple)) and isinstance(files, (list, tuple)), "policy", "bad dirs/files")
+    for rel in dirs:
+        check_rel(rel)
+        name_gate(role.root + "/" + rel, policy.host, role.grants)
+    records = []
+    for f in files:
+        require(isinstance(f, dict), "policy", "files must be dicts")
+        e4, e5 = f.get("e4", False) is True, f.get("e5", False) is True
+        _gate(policy, role_name, f.get("dst"), "write", e4, e5=e5)
+        records.append({"rel": f["dst"], "size": f.get("size"), "sha256": f.get("sha256"),
+                        "mode": f.get("mode", 0o444), "e4": e4, "e5": e5})
+    req = {"schema": RECEIVE_REQUEST_SCHEMA, "host": policy.host, "root": role.root, "grants": sorted(role.grants),
+           "dirs": list(dirs), "files": records, "max_total": max_total}
+    try:
+        _RECEIVE_NS["validate_receive"](req)
+    except Refusal as error:
+        refuse(error.code, "local manifest check: " + error.reason)
+    return json.dumps(req, sort_keys=True, separators=(",", ":")).encode()
+
+
+def receive_ssh_argv(host, program_bytes, manifest_bytes, ssh_binary=SSH_BINARY):
+    """ssh argv for the receiver: every word is [A-Za-z0-9/-] except the fixed single-quoted RECEIVE_BOOTSTRAP."""
+    require(host in HOSTS, "policy", "unknown host %r" % (host,))
+    require("'" not in RECEIVE_BOOTSTRAP, "policy", "bootstrap must not contain a single quote")
+    return [ssh_binary] + list(SSH_OPTIONS) + ["--", host, "nice", "-n", "19", REMOTE_PYTHON, "-I", "-S", "-c",
+                                               "'" + RECEIVE_BOOTSTRAP + "'", str(len(program_bytes)),
+                                               hashlib.sha256(program_bytes).hexdigest(),
+                                               hashlib.sha256(manifest_bytes).hexdigest()]
+
+
+def _receive_stream(program, manifest, local_policy, files):
+    yield program
+    yield len(manifest).to_bytes(8, "big")
+    yield manifest
+    for f in files:
+        item = _open_gated(local_policy, f["src_role"], f["src_rel"], f["size"], None, f.get("e4", False) is True,
+                           e5=f.get("e5", False) is True)
+        digest = hashlib.sha256()
+        for chunk in item.chunks():
+            digest.update(chunk)
+            yield chunk
+        require(digest.hexdigest() == f["sha256"], "sha", "local source %s:%s does not match its expected SHA-256"
+                % (f["src_role"], f["src_rel"]))
+
+
+_RECEIPT_OK = ("dirs", "files", "host", "manifest_sha256", "root", "schema", "status")
+_RECEIPT_REFUSED = ("code", "created", "host", "manifest_sha256", "reason", "schema", "status", "where")
+
+
+def parse_receive_receipt(manifest_bytes, rc, stdout):
+    """Strict validation of the receiver's one-line receipt against the exact manifest: rc 0 = ok with every file's
+    rel/size/sha256 equal to the manifest, st_nlink 1, regular, the declared mode; rc 3 = a well-formed refusal
+    (raised as Refusal('remote-refused'), with what was already created); anything else refuses."""
+    request = loads_strict(manifest_bytes, "receive manifest")
+    require(type(rc) is int and rc in (0, 3), "remote", "receiver exited %r" % (rc,))
+    require(isinstance(stdout, bytes) and stdout.endswith(b"\n") and stdout.count(b"\n") == 1, "remote",
+            "receiver output is not exactly one line")
+    reply = loads_strict(stdout, "receive receipt")
+    require(isinstance(reply, dict) and reply.get("schema") == RECEIVE_RECEIPT_SCHEMA, "remote", "bad schema")
+    require(reply.get("manifest_sha256") == hashlib.sha256(manifest_bytes).hexdigest(), "remote",
+            "manifest SHA differs")
+    if rc == 3:
+        require(tuple(sorted(reply)) == _RECEIPT_REFUSED and reply["status"] == "refused", "remote",
+                "rc 3 without a well-formed refusal")
+        refuse("remote-refused", "%s: %s at %r (host %s; created, kept: %r)" % (
+            reply["code"], reply["reason"], reply["where"], reply["host"], reply["created"]))
+    require(tuple(sorted(reply)) == _RECEIPT_OK and reply["status"] == "ok", "remote", "rc 0 without status ok")
+    require(reply["host"] == request["host"] and reply["root"] == request["root"] and reply["dirs"] == request["dirs"],
+            "remote", "receipt host/root/dirs differ from the manifest")
+    got = reply["files"]
+    require(isinstance(got, list) and len(got) == len(request["files"]), "remote", "receipt file count differs")
+    for asked, record in zip(request["files"], got):
+        require(isinstance(record, dict) and sorted(record) == ["dev", "ino", "mode", "nlink", "rel", "sha256", "size"],
+                "remote", "bad receipt record")
+        require(all(type(record[k]) is int and record[k] >= 0 for k in ("dev", "ino", "mode", "nlink", "size")),
+                "remote", "bad receipt metadata")
+        require(record["rel"] == asked["rel"] and record["size"] == asked["size"]
+                and record["sha256"] == asked["sha256"], "remote", "receipt for %s differs" % asked["rel"])
+        require(record["nlink"] == 1, "nlink", "received %s has st_nlink %d" % (asked["rel"], record["nlink"]))
+        require(stat.S_ISREG(record["mode"]) and stat.S_IMODE(record["mode"]) == asked["mode"], "not-regular",
+                "received %s is not a regular file with mode %o" % (asked["rel"], asked["mode"]))
+    return reply
+
+
+def remote_receive(policy, role_name, local_policy, files, dirs=(), max_total=None, ssh_binary=SSH_BINARY,
+                   timeout=3600):
+    """D4 sender: one ssh login runs the receive program (bootstrap-verified by SHA-256) and streams the framed
+    manifest + file bytes. files: [{src_role, src_rel, dst, size, sha256, mode?, e4?, e5?}]; every source is read
+    from `local_policy` through the descriptor gate with its expected size, and its SHA-256 is required (production
+    reads require expected SHAs) and re-checked while streaming. An E5 source must be at the same exact E5 path and
+    passes hash_e5 (pinned blob OID, SHA-256 equal to the declared one) before ssh starts. All local and destination
+    names are gated before ssh starts. Returns the parsed receipt."""
+    require(isinstance(local_policy, Policy) and not local_policy.remote, "policy", "a local source Policy is required")
+    for f in files:
+        require(isinstance(f, dict) and type(f.get("size")) is int and isinstance(f.get("sha256"), str)
+                and SHA256_HEX.fullmatch(f["sha256"]) is not None, "policy", "every file needs size and sha256")
+        e5 = f.get("e5", False) is True
+        require(not e5 or f.get("src_rel") == f.get("dst"), "exemption", "an E5 file keeps its exact path")
+        _gate(local_policy, f.get("src_role"), f.get("src_rel"), "read", f.get("e4", False) is True, e5=e5)
+    total = sum(f["size"] for f in files) if max_total is None else max_total
+    manifest = build_receive_manifest(policy, role_name, list(dirs), list(files), total)
+    for f in files:                       # descriptor gate of every source (no byte read) before ssh starts
+        if f.get("e5", False) is True:    # E5: pinned blob OID and the declared SHA-256, before ssh starts
+            got = hash_e5(local_policy, f["src_role"], f["src_rel"])
+            require(got["sha256"] == f["sha256"] and got["size"] == f["size"], "sha",
+                    "E5 source %s does not match its declared SHA-256/size" % f["src_rel"])
+            continue
+        _open_gated(local_policy, f["src_role"], f["src_rel"], f["size"], None, f.get("e4", False) is True).close()
+    program = receive_program_source().encode()
+    limit = 4096 + sum(400 + len(f["dst"]) for f in files) + sum(len(d) + 8 for d in dirs)
+    result = run_checked(receive_ssh_argv(policy.host, program, manifest, ssh_binary), timeout, limit,
+                         stdin_bytes=_receive_stream(program, manifest, local_policy, files), ok_rcs=(0, 3, 4),
+                         env={"LC_ALL": "C"}, stdin_break_ok_on_nonzero=True)
+    return parse_receive_receipt(manifest, result.rc, result.stdout)
+
+
+def main(argv=None):
+    """CLI for host shell wrappers (one exact-name write role per call; exit 0 ok, 3 refused, 2 usage):
+      create-excl  --host H --root R --rel REL --max-size N [--grant G]... [--mode 0444]   (bytes from stdin)
+      mkdir-excl   --host H --root R --rel REL [--grant G]...
+      publish-excl --host H --root R --rel TMP --final REL [--grant G]...
+      remote-program-sha256
+      receive-program-sha256"""
+    import argparse
+    ap = argparse.ArgumentParser(prog="safe_input", allow_abbrev=False)
+    sub = ap.add_subparsers(dest="command")
+    for name in ("create-excl", "mkdir-excl", "publish-excl"):
+        p = sub.add_parser(name, allow_abbrev=False)
+        p.add_argument("--host", required=True)
+        p.add_argument("--root", required=True)
+        p.add_argument("--rel", required=True)
+        p.add_argument("--grant", action="append", default=[])
+        if name == "create-excl":
+            p.add_argument("--max-size", type=int, required=True)
+            p.add_argument("--mode", default="0444")
+        if name == "publish-excl":
+            p.add_argument("--final", required=True)
+    sub.add_parser("remote-program-sha256", allow_abbrev=False)
+    sub.add_parser("receive-program-sha256", allow_abbrev=False)
+    a = ap.parse_args(argv)
+    if a.command is None:
+        ap.print_usage(sys.stderr)
+        return 2
+    if a.command == "remote-program-sha256":
+        print(remote_program_sha256())
+        return 0
+    if a.command == "receive-program-sha256":
+        print(receive_program_sha256())
+        return 0
+    try:
+        names = (a.rel, a.final) if a.command == "publish-excl" else (a.rel,)
+        size = a.max_size if a.command == "create-excl" else 1
+        policy = Policy(a.host, [Role("cli", a.root, "write", size, exact=names, grants=a.grant)])
+        with Writer(policy, "cli") as writer:
+            if a.command == "mkdir-excl":
+                writer.mkdir_excl(a.rel)
+            elif a.command == "publish-excl":
+                writer.publish_excl(a.rel, a.final)
+            else:
+                require(re.fullmatch(r"0[0-7]{3}", a.mode) is not None, "policy", "--mode must be octal like 0444")
+                out = writer.open_excl(a.rel)
+                try:
+                    stream = sys.stdin.buffer
+                    while True:
+                        chunk = stream.read(CHUNK)
+                        if not chunk:
+                            break
+                        out.write(chunk)
+                except BaseException:
+                    out.abort()
+                    raise
+                result = out.finish(int(a.mode, 8))
+                print(json.dumps(result, sort_keys=True))
+    except Refusal as error:
+        sys.stderr.write("REFUSE %s\n" % error)
+        return 3
+    return 0
+
+
+def remote_check(policy, items, max_content=0, ssh_binary=SSH_BINARY, timeout=300):
+    """One ssh login: ship remote_program_source() on stdin, the request as one hex word; parse strictly."""
+    request = build_remote_request(policy, items, max_content)
+    limit = 4096 + 1024 * len(items) + 2 * max_content
+    result = run_checked(remote_ssh_argv(policy.host, request, ssh_binary), timeout, limit,
+                         stdin_bytes=remote_program_source().encode(), ok_rcs=(0, 3), env={"LC_ALL": "C"})
+    return parse_remote_response(request, result.rc, result.stdout)
+
+
+if __name__ == "__main__":
+    sys.exit(main())
