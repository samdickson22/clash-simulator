+                require(len(data) == got["size"] and hashlib.sha256(data).hexdigest() == got["sha256"], "remote",
+                        "content does not match its size/SHA")
+                got["content"] = data
+            else:
+                require(b64 is None, "remote", "unrequested content returned")
+        out.append(got)
+    return out
