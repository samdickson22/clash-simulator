+#!/usr/bin/env bash
+# K4S END PREFLIGHT wrapper r3 (S5; derived from k4s_end_exit_push.sh r2, safe_input adoption). Review required.
+# Runs k4s_end_preflight.py once in the foreground through frozen-exec (never end_reference.py), then pushes the
+# preflight directory to 05. No shell redirection writes any file: argv.nul, exit.json, TRANSFER-DONE.json and
+# PUSH-FAILED.json are created through the pinned safe_input CLI (exclusive, no-follow, never replaced). The
+# registry/attempt-parent listings are taken by the preflight itself through safe_input.
+# Frozen detach.sh must use $job/detach.log and $job/detach.json.
+set -u -o pipefail
+job=${1:?JOB}
+shift
+python=/usr/bin/python3
+host=$(hostname) || exit 90
+case "$host" in
+  127x03) base=/mpac/sdicks02/jobs/clasher/k4s-end-r1 ;;
+  127x04) base=/mpac/sdicks02/jobs-k4s/k4s-end-r1 ;;
+  *) exit 90 ;;
+esac
+receive_base=/mpac/sdicks02/k4s-runner/run-r1/preflight-received
+tools=$base/tools
+host_tool=$tools/k4s_end_host_tool.py
+host_tool_sha=22c441b1db0fb7e1cf31cd259a5e838f375a7a935b3c78f5f5f5891869508647
+case "$job" in */|*..*|*[[:space:]]*) exit 90 ;; esac
+attempt=${job##*/}
+[[ "$attempt" =~ ^preflight-${host}-l[0-9]{2}$ ]] || exit 90
+parent=${job%/*}
+test "$parent" = "$base/preflight" || exit 90
+measurement=$job/$attempt
+repository=$base/repository
+attempts=$base/attempts
+test -d "$job" && test ! -L "$job" || exit 90
+for name in "$attempt" exit.json exit.json.tmp argv.nul TRANSFER-DONE.json TRANSFER-DONE.json.tmp PUSH-FAILED.json; do
+  test ! -e "$job/$name" && test ! -L "$job/$name" || exit 90
+done
+test -f "$job/detach.log" && test ! -L "$job/detach.log" || exit 90
+test -s "$job/detach.json" && test ! -L "$job/detach.json" || exit 90
+host_tool_size=34444
+# ==== BEGIN K4S CANONICAL SHELL BOOTSTRAP r1 (bootstrap-r1/k4s_bootstrap_shell_r1.sh; paste verbatim) ====
+# END-FULL-F1 for the host-tool wrappers. Requires, set before this fragment: python (/usr/bin/python3), host_tool
+# (absolute normalized path), host_tool_sha (64 lowercase hex), host_tool_size (decimal byte count). Replaces the
+# `test -f "$host_tool"` + `sha256sum --check` pair and the plain `tool()` definition. Every tool run re-walks,
+# re-gates and re-hashes the host tool and executes exactly the verified bytes as __main__; nothing is hashed by
+# sha256sum and the interpreter opens no script by path. Loader refusal: exit status 90, one line on stderr.
+k4s_loader='# ==== BEGIN K4S CANONICAL BOOTSTRAP r1 (bootstrap-r1/k4s_bootstrap_r1.py; paste verbatim, byte for byte) ====
+# END-FULL-F1. The only way a K4S END component may read a pinned stdlib-loaded file (its vendored safe_input layer,
+# or a host tool) before the shared layer exists. Stdlib only, Python 3.8+, Linux, no assert (holds under -O), no
+# single-quote character (so the same text can sit inside a single-quoted shell word). Contract, in order:
+#   1. the path is absolute and already normalized (normpath(p) == p; no empty, "." or ".." component, no trailing
+#      slash, no control or backslash character). Nothing is canonicalized: realpath is never called;
+#   2. every component (ancestors and leaf) passes the safe_input r3 OUTCOME name families (casefolded fullmatch,
+#      the same regex literals; conformance-tested against si.outcome_family);
+#   3. a component-wise walk from "/": each ancestor is opened O_DIRECTORY|O_NOFOLLOW relative to its parent fd and
+#      fstat must say directory (a symlink, a non-directory or a missing ancestor refuses);
+#   4. the leaf is fstatat-ed without following (regular, st_nlink == 1, exactly the pinned size) BEFORE it is opened,
+#      then opened O_NOFOLLOW|O_NONBLOCK relative to the parent fd and fstat-ed again (same dev/ino, regular,
+#      st_nlink == 1, pinned size) BEFORE any byte is read;
+#   5. exactly the pinned size is read from THAT descriptor, EOF is confirmed, the SHA-256 must equal the pin, and
+#      exactly those bytes are compiled and executed in a fresh module registered under the caller-given name. The
+#      code object is compiled under a "<k4s-bootstrap ...>" filename (linecache is given the verified lines) so no
+#      traceback, import or inspect call ever re-opens the path after hashing;
+#   6. every refusal is `raise refusal(message)`, the caller-chosen refusal convention (an exception class, or a
+#      callable returning the exception to raise).
+K4S_BOOTSTRAP_RELEASE = "k4s-bootstrap-r1"
+K4S_BOOTSTRAP_OUTCOME_FAMILIES = (                      # == safe_input r3 OUTCOME_FAMILIES (literal copy, tested)
+    ("games", r"(?:.*[^a-z])?" + r"games" + r"(?:[^a-z].*)?"),
+    ("hub-blocks", r"(?:.*[^a-z])?" + r"hub[-_.]?blocks?" + r"(?:[^a-z].*)?"),
+    ("complete-json", r".*complete.*\.json.*"),
+    ("interference-json", r".*interference.*\.json.*"),
+    ("hub-ack-json", r".*hub[-_.]?ack.*\.json.*"),
+    ("end-raw-json", r".*end[-_.]?raw.*\.json.*"),
+)
+K4S_BOOTSTRAP_MAX_SIZE = 1 << 24
+
+
+def k4s_bootstrap_name_family(component):
+    """The OUTCOME family label of one path component (casefolded fullmatch), or None."""
+    import re
+    folded = component.casefold()
+    for label, rx in K4S_BOOTSTRAP_OUTCOME_FAMILIES:
+        if re.fullmatch(rx, folded, re.S):
+            return label
+    return None
+
+
+def k4s_bootstrap_default_path(module_file, leaf):
+    """The sibling `leaf` of `module_file`, made absolute without resolving or normalizing anything: an alias or a
+    non-normalized __file__ stays visible, so the walk refuses it."""
+    import os
+    directory = os.path.dirname(module_file)
+    if not directory.startswith("/"):
+        directory = os.getcwd() + ("/" + directory if directory else "")
+    return directory + "/" + leaf
+
+
+def k4s_bootstrap_read_verified(path, sha256, size, refusal):
+    """Steps 1-5 up to the hash: return exactly the pinned bytes, or raise refusal(message) having read nothing that
+    fails a name, walk or descriptor gate."""
+    import hashlib
+    import os
+    import stat
+
+    def refused(reason):
+        return refusal("k4s bootstrap refused: " + reason + ": " + repr(path))
+
+    if not isinstance(sha256, str) or len(sha256) != 64 or any(c not in "0123456789abcdef" for c in sha256):
+        raise refused("the SHA-256 pin is not 64 lowercase hex digits")
+    if type(size) is not int or not 0 < size <= K4S_BOOTSTRAP_MAX_SIZE:
+        raise refused("the size pin is not an int in 1..%d" % K4S_BOOTSTRAP_MAX_SIZE)
+    if (not isinstance(path, str) or not path.startswith("/") or path.startswith("//") or path.endswith("/")
+            or os.path.normpath(path) != path):
+        raise refused("not an absolute normalized path")
+    if "\\" in path or any(ord(c) < 32 or ord(c) == 127 for c in path):
+        raise refused("control or backslash character in the path")
+    parts = path[1:].split("/")
+    if any(p in ("", ".", "..") for p in parts):
+        raise refused("empty, . or .. component")
+    for p in parts:
+        family = k4s_bootstrap_name_family(p)
+        if family is not None:
+            raise refused("outcome name family " + family + " in component " + repr(p))
+    fd = os.open("/", os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC)
+    try:
+        if not stat.S_ISDIR(os.fstat(fd).st_mode):
+            raise refused("/ is not a directory")
+        for name in parts[:-1]:
+            try:
+                child = os.open(name, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC, dir_fd=fd)
+            except OSError as error:
+                raise refused("ancestor " + repr(name) + " is a symlink, not a directory or missing ("
+                              + os.strerror(error.errno) + ")")
+            previous, fd = fd, child
+            os.close(previous)
+            if not stat.S_ISDIR(os.fstat(fd).st_mode):
+                raise refused("ancestor " + repr(name) + " is not a directory")
+        leaf = parts[-1]
+        try:
+            before = os.stat(leaf, dir_fd=fd, follow_symlinks=False)
+        except OSError as error:
+            raise refused("leaf cannot be inspected (" + os.strerror(error.errno) + ")")
+        if not stat.S_ISREG(before.st_mode) or before.st_nlink != 1 or before.st_size != size:
+            raise refused("leaf is not a single-link regular file of the pinned size %d" % size)
+        try:
+            leaf_fd = os.open(leaf, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_NOCTTY | os.O_CLOEXEC,
+                              dir_fd=fd)
+        except OSError as error:
+            raise refused("leaf cannot be opened without following (" + os.strerror(error.errno) + ")")
+        try:
+            info = os.fstat(leaf_fd)
+            if (not stat.S_ISREG(info.st_mode) or info.st_nlink != 1 or info.st_size != size
+                    or (info.st_dev, info.st_ino) != (before.st_dev, before.st_ino)):
+                raise refused("opened leaf is not the inspected single-link regular file of the pinned size")
+            chunks, left = [], size
+            while left > 0:
+                chunk = os.read(leaf_fd, left)
+                if not chunk:
+                    raise refused("leaf shrank while read")
+                chunks.append(chunk)
+                left -= len(chunk)
+            if os.read(leaf_fd, 1) != b"":
+                raise refused("leaf grew while read")
+        finally:
+            os.close(leaf_fd)
+    finally:
+        os.close(fd)
+    data = b"".join(chunks)
+    if len(data) != size or hashlib.sha256(data).hexdigest() != sha256:
+        raise refused("bytes are not the pinned SHA-256 " + sha256)
+    return data
+
+
+def k4s_bootstrap_exec(data, path, sha256, module_name):
+    """Step 5 tail: compile and execute exactly `data` (already verified) in a fresh module named `module_name`."""
+    import linecache
+    import sys
+    import types
+    filename = "<k4s-bootstrap sha256=" + sha256 + " " + path + ">"
+    linecache.cache[filename] = (len(data), None, data.decode("utf-8", "replace").splitlines(True), filename)
+    code = compile(data, filename, "exec", dont_inherit=True)
+    module = types.ModuleType(module_name)
+    module.__file__ = path
+    module.__k4s_bootstrap__ = (K4S_BOOTSTRAP_RELEASE, path, sha256, len(data))
+    previous = sys.modules.get(module_name)
+    sys.modules[module_name] = module
+    try:
+        exec(code, module.__dict__)
+    except BaseException:
+        if previous is None:
+            sys.modules.pop(module_name, None)
+        else:
+            sys.modules[module_name] = previous
+        raise
+    return module
+
+
+def k4s_bootstrap_load(path, sha256, size, module_name, refusal):
+    """Read `path` through the full contract and execute exactly the verified bytes as module `module_name`."""
+    data = k4s_bootstrap_read_verified(path, sha256, size, refusal)
+    return k4s_bootstrap_exec(data, path, sha256, module_name)
+# ==== END K4S CANONICAL BOOTSTRAP r1 ====
+# ==== BEGIN K4S CANONICAL SHELL LOADER r1 main (bootstrap-r1/k4s_bootstrap_loader_r1.py = the bootstrap above + this) ====
+# Run ONLY as:  /usr/bin/python3 -I -S -c "$k4s_loader" PATH SHA256 SIZE -- ARGS...   (runs the tool as __main__)
+#          or:  /usr/bin/python3 -I -S -c "$k4s_loader" PATH SHA256 SIZE --verify-only (checks, executes nothing)
+# The interpreter opens no script by path; this loader never reads stdin (a pipe into the tool reaches the tool
+# untouched) and creates no file. Refusal: one line on stderr, exit status 90 (the wrapper bootstrap refusal).
+
+
+def k4s_bootstrap_loader_main(argv):
+    import re
+    import sys
+
+    def refusal(message):
+        sys.stderr.write(message + "\n")
+        sys.stderr.flush()
+        return SystemExit(90)
+
+    if not (sys.flags.isolated and sys.flags.no_site):
+        raise refusal("k4s bootstrap refused: the loader must run under python3 -I -S")
+    if (len(argv) < 4 or argv[3] not in ("--", "--verify-only") or (argv[3] == "--verify-only" and len(argv) != 4)
+            or not re.fullmatch(r"[1-9][0-9]{0,8}", argv[2])):
+        raise refusal("k4s bootstrap refused: usage: PATH SHA256 SIZE -- ARGS... | PATH SHA256 SIZE --verify-only")
+    path, sha256, size = argv[0], argv[1], int(argv[2])
+    data = k4s_bootstrap_read_verified(path, sha256, size, refusal)
+    if argv[3] == "--verify-only":
+        return 0
+    sys.argv = [path] + list(argv[4:])
+    k4s_bootstrap_exec(data, path, sha256, "__main__")
+    return 0
+
+
+raise SystemExit(k4s_bootstrap_loader_main(__import__("sys").argv[1:]))
+# ==== END K4S CANONICAL SHELL LOADER r1 main ====
+'
+k4s_verify_host_tool() { "$python" -I -S -c "$k4s_loader" "$host_tool" "$host_tool_sha" "$host_tool_size" --verify-only; }
+tool() { "$python" -I -S -c "$k4s_loader" "$host_tool" "$host_tool_sha" "$host_tool_size" -- "$@"; }
+k4s_verify_host_tool || exit 90
+# ==== END K4S CANONICAL SHELL BOOTSTRAP r1 ====
+output_count=0
+expect_output=false
+repository_count=0
+expect_repository=false
+parent_count=0
+expect_parent=false
+script_count=0
+for arg in "$@"; do
+  if "$expect_output"; then
+    test "$arg" = "$measurement" || exit 90
+    expect_output=false
+  elif "$expect_repository"; then
+    test "$arg" = "$repository" || exit 90
+    expect_repository=false
+  elif "$expect_parent"; then
+    test "$arg" = "$attempts" || exit 90
+    expect_parent=false
+  elif test "$arg" = --out; then
+    output_count=$((output_count + 1))
+    expect_output=true
+  elif test "$arg" = --repository; then
+    repository_count=$((repository_count + 1))
+    expect_repository=true
+  elif test "$arg" = --attempt-parent; then
+    parent_count=$((parent_count + 1))
+    expect_parent=true
+  else
+    case "$arg" in --o*|--rep*|--at*) exit 90 ;; esac
+    case "$arg" in */end_reference.py|end_reference.py) exit 90 ;; esac
+    case "$arg" in "$tools/k4s_end_preflight.py") script_count=$((script_count + 1)) ;; esac
+  fi
+done
+test "$output_count" = 1 && ! "$expect_output" || exit 90
+test "$repository_count" = 1 && ! "$expect_repository" || exit 90
+test "$parent_count" = 1 && ! "$expect_parent" || exit 90
+test "$script_count" = 1 || exit 90
+test "$#" -gt 0 || exit 90
+receive="$receive_base/$host/$attempt"
+receipt=$(printf '%s\0' "$@" | tool si -- create-excl --host "$host" --root "$job" --rel argv.nul --max-size 65536) \
+  || exit 91
+
+# No trap, polling, timer or network call while the foreground preflight runs.
+tool frozen-exec -- "$@"
+measurement_exit=$?
+exit_utc=$(date -u '+%Y-%m-%dT%H:%M:%SZ')
+measurement_exists=false
+test ! -d "$measurement" || measurement_exists=true
+receipt=$(printf '{"utc":"%s","host":"%s","attempt":"%s","exit_code":%s,"command_exited":true,"measurement_exists":%s}\n' \
+  "$exit_utc" "$host" "$attempt" "$measurement_exit" "$measurement_exists" \
+  | tool si -- create-excl --host "$host" --root "$job" --rel exit.json.tmp --max-size 4096) || exit 91
+tool si -- publish-excl --host "$host" --root "$job" --rel exit.json.tmp --final exit.json || exit 91
+
+# Count and total deadline bound post-exit transport; never retry the preflight.
+deadline=$((SECONDS + 1200))
+push_file() {
+  local source=$1 target=$2 limit=$3 tries=0 rc=0 remaining
+  while test "$tries" -lt 3; do
+    remaining=$((deadline - SECONDS))
+    test "$remaining" -gt 0 || return 124
+    test "$remaining" -ge "$limit" || limit=$remaining
+    tries=$((tries + 1))
+    timeout -k 30 "$limit" nice -n 9 taskset -c 62 rsync \
+      -a --checksum --partial "$source" "127x05:$target"
+    rc=$?
+    test "$rc" -ne 0 || return 0
+    case "$rc" in 255|10|12|30|35|124|137) ;; *) return "$rc" ;; esac
+    test "$tries" -ge 3 || sleep 10
+  done
+  return "$rc"
+}
+failed=0
+for name in exit.json detach.log detach.json argv.nul; do
+  push_file "$job/$name" "$receive/" 30 || failed=1
+done
+if "$measurement_exists"; then
+  push_file "$measurement/" "$receive/preflight/" 900 || failed=1
