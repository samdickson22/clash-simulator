         'mount --rbind "$1" /mpac/sdicks02 && hostname "$2" && cd / && exec /bin/sh -c "$3"') % venv
done = subprocess.run(["/usr/bin/unshare", "-Urmu", "/bin/sh", "-c", inner, "shim", ROOT + "/" + host, host, command],
                      env={"PATH": "/usr/bin:/bin", "LC_ALL": "C", "HOME": "/home/sdicks02"}, stdout=subprocess.PIPE)
