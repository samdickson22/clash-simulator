run_s5 () 
{ 
    mkdir -p $H/127x03/jobs/clasher/k4s-end-r1/preflight/preflight-127x03-l$1;
    cd /tmp && FAKEROOT=$H env -i PATH=/usr/bin:/bin HOME=/home/sdicks02 LANG=C.UTF-8 FAKEROOT=$H nice -n 19 taskset -c 0-15 $W/drivers/ns.sh 127x03 /mpac/sdicks02/jobs/clasher/e4v3-venv/bin/python -I -B $W/drivers/s5_drive.py $(sh $W/drivers/s5_args.sh $1) > $W/logs/s5-03-l$1.out 2> $W/logs/s5-03-l$1.err;
    echo "rc=$?"
}
